
// ============================================================================
// GlobalFeatureStore 架构设计
// ============================================================================
//
// 按照日期, 切分Tensor: {[T, F, A]_level0(second), [T, F, A]_level1(minute), [T, F, A]_level2(hour)}_dayN
//
// 设计最大容量 (理论上限):
//   T (Time):    max = 100,000  (L0: 100K time indices per day, 可配置为 tick/millisecond/second)
//   A (Asset):   max = 1,000    (1K assets in universe)
//   F (Feature): max = 1,000    (all feature types combined per level)
//
// 实际配置示例:
//   T: L0=14401 (4h×3600s+1), L1=241 (4h×60min+1), L2=5 (4h+1)
//   A: 107 assets
//   F: L0=15, L1=11, L2=11
//
// 特征分类:
//   F_TS: 时序特征 (单 asset 时间序列计算)
//   F_CS: 截面特征 (跨 assets 横截面计算)
//   F_LB: 标签 (预测目标)
//   F_SH: 共享中间值 (TS/CS 共用)
//   F_META: 元数据 (backend 内部, 如 _link_to_L1/_link_to_L2)
//
// 访问模式分析 (优化目标: 最小化总内存访问时间)
//
// 操作           循环结构                       单次vector访问   总内存访问量                权重    并行度
// TS_write_TS    for a: for t: write[F_TS]     连续写600个      TxAxF_TS        = 240GB     39%   10 cores
// CS_read_TS     for t: for f: read[A]         连续读1000个     Tx(F_TS+F_OT)xA = 280GB     45%   1 core
// CS_write_CS    for t: for f: write[A]        连续写1000个     TxF_CSxA        = 100GB     16%   1 core
//
// 详细说明:
// - TS_write: 每个core处理~100个assets, 对每个asset遍历时间, 在(a,t)处连续写F_TS个features
// - CS_read:  在每个时刻t, 对每个feature f, 连续读取所有A个assets的值(截面计算)
// - CS_write: 在每个时刻t, 对每个feature f, 连续写入所有A个assets的值(截面结果)
//
// 布局          地址公式               TS_write(39%)      CS_read(45%)      CS_write(16%)   加权总分   推荐度
// [T][A][F]    (t*A+a)*F+f            连续/100分         跳4KB/60分        跳4KB/60分        75.6      良好
// [T][F][A]    (t*F+f)*A+a            跳4KB/60分         连续/100分        连续/100分        84.4      最优 √√√
// [A][T][F]    (a*T+t)*F+f            连续/100分         跳400MB/5分       跳400MB/5分       42.0      较差
// [A][F][T]    (a*F+f)*T+t            跳400KB/20分       跳400MB/5分       跳400MB/5分       10.9      极差
// [F][T][A]    (f*T+t)*A+a            跳400MB/5分        连续/100分        连续/100分        63.0      不推荐
// [F][A][T]    (f*A+a)*T+t            跳400MB/5分        跳400KB/20分      跳400KB/20分      14.2      极差
//
// stride=4B:连续访问(SIMD/prefetch)优化; 
// stride=64B: cache line访问优化;
// stride<4KB: TLB/Page优化; 
// stride<32KB: L1访问优化; 
// stride<1MB: L2访问优化; 
//
// ============================================================================
// 【Tensor Pool 架构 - 简洁设计 + 无锁优化
// ============================================================================
//
// 【Worker 分工】N cores = (N-2) TS + 1 CS + 1 IO (可选设置cpu亲和)
//   - TS Workers (N-2): 时序特征计算,按 asset 分配,date-first 遍历(在time index级别是 顺序, 稀疏, 而且per asset不同的, 所以需要progress机制)
//   - CS Worker  (1):  截面特征计算,等待 TS 完成后处理 (与TS的sync粒度必须细, 到time index级别, 这样和实盘行为才是一致的)
//   - IO Worker  (1):  扫描 pool,异步 flush 完成的 date
//
// 【核心数据结构】
//
//   // Tensor lifecycle states
//   enum class TensorState : uint8_t {
//     FREE = 0,        // Available for allocation
//     INIT = 1,        // Being initialized
//     BUSY = 2,        // Active (TS writing + CS reading/writing)
//     DONE = 3,        // CS finished, ready for flush
//     FLUSH = 4        // IO worker writing to disk
//   };
//
//   // Per-date tensor slot (position-based 同步 + 事件驱动)
//   struct Slot {
//     // 状态机: FREE → INIT → BUSY → DONE → FLUSH → FREE
//     std::atomic<TensorState> state;
//     std::atomic<uint32_t> epoch;               // Generation number (检测 slot 回收, 用 acq_rel)
//     char date[16];                             // 当前绑定的日期 (format: "YYYYMMDD\0", 固定大小, 可原子拷贝)
//     _Float16* data[3];                         // [T,F,A] tensors for L0/L1/L2
//
//     // 同步机制(核心:two-level write_pos,优化 CS 扫描)
//     std::atomic<size_t>* ts_write_pos;         // length = A (每个 asset 的 L0 写入位置)
//                                                // ts_write_pos[a] = asset a 已写入的最大 L0 时间索引 + 1
//                                                // TS worker: 写完 (a, t) 后 store(t+1, release)
//                                                // 用于准确维护,支持细粒度查询
//     std::atomic<size_t>* ts_worker_min_pos;    // length = num_ts_workers (每个 TS worker 的最小写入位置)
//                                                // ts_worker_min_pos[w] = worker w 负责的所有 assets 的 min(write_pos)
//                                                // TS worker: 维护 thread-local min,定期 store(min, release)
//                                                // CS: 快速扫描 O(W) vs O(A),W=10, A=1000
//     std::atomic<bool>* ts_done_flag;           // length = num_ts_workers (每个 TS worker 的完成标志)
//                                                // TS worker: 完成 date 后 store(true, release)
//                                                // CS: 全部 true 时不再等待 min_pos 增长
//
//     // CS 读取位置缓存(避免重复扫描 ts_worker_min_pos)
//     std::atomic<size_t> cs_read_pos;           // CS 已验证的安全读位置 (atomic 支持未来多 CS worker 扩展)
//                                                // cs_read_pos = N 表示 [0, N-1] 的 time_idx 已验证就绪
//                                                // CS 每次 sweep 扫描 ts_worker_min_pos 得到 min_pos,
//                                                // 一次可以推进几百个 time_idx(O(W) 扫描,极快)
//                                                // 当前单 CS worker: 使用 relaxed load/store 即可
//
//     // Freelist linkage
//     std::atomic<int> next_free;                // Freelist 链表指针 (-1 = end)
//   };
//
//   // TS worker cache entry (per-worker, lock-free hot path)
//   struct TSCacheEntry {
//     std::string date;                          // Cached date
//     int idx;                                   // Slot index in pool
//     uint32_t epoch;                            // Cached epoch (detect slot recycling)
//   };
//
//   // CS worker cache entry (single-threaded)
//   struct CSCacheEntry {
//     std::string date;                          // Cached date
//     int idx;                                   // Slot index in pool
//     uint32_t epoch;                            // Cached epoch (detect slot recycling)
//   };
//
//   全局变量:
//     Slot* pool;                                // 预分配 slot 数组
//     size_t pool_size = num_ts_workers * POOL_SIZE_FACTOR;  // Pool 大小 (POOL_SIZE_FACTOR=2)
//     std::atomic<uint64_t> free_head{0};        // 无锁栈头 + ABA 防护
//                                                // 格式: (tag << 32) | slot_idx
//                                                // 高 32 位: version tag (防 ABA)
//                                                // 低 32 位: slot index
//                                                // 初始值: 0 (tag=0, idx=0→1→2...)
//     std::map<string, size_t> date_to_slot_;    // date → slot_idx 映射 (需要 mutex 保护)
//     std::mutex pool_mutex_;                    // 保护 date_to_slot_ 和状态转换
//     vector<TSCacheEntry> ts_cache_;            // TS worker cache 数组 (per-worker, 需 epoch 验证)
//     CSCacheEntry cs_cache_;                    // CS worker cache (单线程, 需 epoch 验证)
//
//     // TS worker 动态资产跟踪(运行时记录,解耦业务分配逻辑)
//     vector<unordered_set<size_t>> assigned_assets_;  // 每个 worker 实际写过的 asset 集合
//                                                      // 在 ts_update() 首次写入时自动记录
//                                                      // Store 层通过实际写入行为学习分配关系
//                                                      // 支持业务层任意负载均衡策略(无需预先告知 Store)
//
//   Thread-local 变量 (每个 TS worker 独立维护):
//     thread_local vector<size_t> worker_local_min;          // 当前 worker_min 缓存 (初始化为 SIZE_MAX)
//     thread_local vector<vector<bool>> asset_written;       // O(1) bitset 追踪写过的 assets
//
//   常量定义:
//     constexpr size_t A = 1000;                 // 最大 asset 数量
//     constexpr size_t T0 = 14400/1440000 + 1;   // L0 最大 time_idx (4 小时 x 3600 秒/360000*10微秒)
//     constexpr size_t F = 1000;                 // 最大 feature 数量
//     constexpr size_t num_ts_workers = 10;      // TS worker 数量
//     constexpr size_t POOL_SIZE = 30;           // Slot pool 大小
//     constexpr size_t PUBLISH_INTERVAL = 10;    // worker_min 发布间隔(每 N 次写入)
//
//   内存估算 (按设计最大容量):
//     - data[L0]: T x F x A x 2B = 100,000 x 1,000 x 1,000 x 2 = 200 GB
//     - data[L1]: T x F x A x 2B (分钟级,T 约几百,F 约几百) ≈ 数百 MB
//     - data[L2]: T x F x A x 2B (小时级,T 约十几,F 约几百) ≈ 数十 MB
//     - remaining_count: T0 x 4B = 100,000 x 4 = 400 KB
//     - Total per slot: ~200 GB (L0 占主导)
//     - 设计上限: Pool 30 slots = 6 TB (需大内存机器或外存支持)
//
//   实际配置示例 (当前测试规模):
//     - A=107, F0=15, T0=14401 → ~47 MB/slot, Pool 30 = 1.4 GB
//
//   Pool Size 建议: pool_size = num_ts_workers * POOL_SIZE_FACTOR
//                   典型配置: 10 TS workers, POOL_SIZE_FACTOR=2 → pool = 20 slots
//
//   辅助函数声明:
//     void write_to_disk(const string &date, Slot *s);  // 异步写盘
//     bool io_try_flush_one();                          // IO worker 尝试 flush 一个 DONE slot
//
//   初始化 (构造函数):
//     GlobalFeatureStore(num_assets, num_ts_workers, output_dir, cs_worker_id, io_worker_id) {
//       pool_size_ = num_ts_workers * POOL_SIZE_FACTOR;
//       pool_ = new Slot[pool_size_];
//       
//       // 1. 分配和初始化每个 slot
//       for (size_t i = 0; i < pool_size_; ++i) {
//         pool_[i].allocate(num_assets_, num_ts_workers_);  // 分配 data/ts_write_pos/ts_worker_min_pos/ts_done_flag
//         
//         // Touch all pages (force physical allocation)
//         for (size_t lvl = 0; lvl < LEVEL_COUNT; ++lvl) {
//           // 按 4KB page 触碰所有内存
//         }
//         
//         // 初始化 freelist linkage
//         pool_[i].next_free.store(i + 1, memory_order_relaxed);
//         pool_[i].state.store(FREE, memory_order_relaxed);
//       }
//       pool_[pool_size_ - 1].next_free.store(-1, memory_order_relaxed);  // 末尾
//       
//       // 2. 初始化 free_head: tag=0, idx=0 (指向第一个 slot)
//       free_head_.store(0, memory_order_release);  // (0 << 32) | 0
//       
//       // 3. 初始化 worker cache 和动态资产跟踪
//       ts_cache_.resize(num_ts_workers_);           // 空 cache
//       assigned_assets_.resize(num_ts_workers_);    // 空集合,运行时自动填充
//     }
//
//
// ============================================================================
// 【完整数据流 - 伪代码】
// ============================================================================
//
// === TS Worker: 获取 slot (fast path + slow path) ===
// Slot& ts_get_slot(date, worker_id) {
//   // Fast path: cache hit with epoch validation
//   if (ts_cache_[worker_id].date == date && ts_cache_[worker_id].slot_idx < pool_size_) [[likely]] {
//     Slot &s = pool_[ts_cache_[worker_id].slot_idx];
//     if (s.epoch.load(memory_order_acquire) == ts_cache_[worker_id].epoch) {
//       return s;  // Cache hit
//     }
//   }
//
//   // Slow path: cache miss or epoch mismatch
//   return ts_get_slot_slow(date, worker_id);
// }
//
// Slot& ts_get_slot_slow(date, worker_id) {
//   pool_mutex_.lock();
//
//   // 1. 检查其他 worker 是否已分配
//   auto it = date_to_slot_.find(date);
//   if (it != date_to_slot_.end()) {
//     size_t slot_idx = it->second;
//     Slot &s = pool_[slot_idx];
//     TensorState state = s.state.load(memory_order_acquire);
//
//     // 1a. 如果 INIT, 另一个线程正在初始化, 释放锁并重试
//     if (state == INIT) {
//       pool_mutex_.unlock();
//       sleep_for(microseconds(10));
//       return ts_get_slot_slow(date, worker_id);  // 递归重试
//     }
//
//     // 1b. Ready to use (BUSY state), 更新 cache 并返回
//     ts_cache_[worker_id].date = date;
//     ts_cache_[worker_id].slot_idx = slot_idx;
//     ts_cache_[worker_id].epoch = s.epoch.load(memory_order_acquire);
//     pool_mutex_.unlock();
//     return s;
//   }
//
//   // 2. 我们是第一个: 分配新 slot (持有 pool_mutex_)
//   allocate_slot_locked(date, worker_id);
//
//   // 3. 分配完成, 更新 cache 并返回
//   it = date_to_slot_.find(date);
//   assert(it != date_to_slot_.end());
//   size_t slot_idx = it->second;
//   Slot &s = pool_[slot_idx];
//   ts_cache_[worker_id].date = date;
//   ts_cache_[worker_id].slot_idx = slot_idx;
//   ts_cache_[worker_id].epoch = s.epoch.load(memory_order_acquire);
//   pool_mutex_.unlock();
//   return s;
// }
//
// void allocate_slot_locked(date, worker_id, wait_count = 0) {
//   // 前置: 调用者持有 pool_mutex_
//
//   // 1. Defense: double-check
//   if (date_to_slot_.find(date) != date_to_slot_.end()) return;
//
//   // 2. Pop from freelist (lock-free CAS)
//   int slot_idx = pop_free();
//   if (slot_idx < 0) {
//     // Pool exhausted, 释放锁并等待 IO 释放 slot
//     pool_mutex_.unlock();
//     sleep_for(milliseconds(10));
//     pool_mutex_.lock();
//     return allocate_slot_locked(date, worker_id, wait_count + 1);  // 递归重试
//   }
//
//   Slot &s = pool_[slot_idx];
//
//   // 3. 立即标记为 INIT 并插入 map (持有锁, 发布分配意图)
//   s.state.store(INIT, memory_order_relaxed);
//   s.epoch.fetch_add(1, memory_order_acq_rel);  // 使旧 cache 失效
//   date_to_slot_[date] = slot_idx;
//
//   // 4. 释放锁, 执行昂贵的 reset 操作
//   pool_mutex_.unlock();
//
//   // 5. Reset slot (清零数据, 初始化同步变量)
//   s.reset(num_assets_, num_ts_workers_);  // 调用 Slot::reset()
//   strncpy(s.date, date.c_str(), sizeof(s.date) - 1);
//   s.date[sizeof(s.date) - 1] = '\0';
//
//   // 6. 发布 BUSY 状态 (slot 可用)
//   s.state.store(BUSY, memory_order_release);
//
//   // 7. 重新获取锁 (恢复调用者持锁状态)
//   pool_mutex_.lock();
// }
//
// === TS Worker: 更新进度 (增量维护 worker_min, 条件发布优化) ===
// void ts_update(date, worker_id, asset_id, l0_time_index) {
//   Slot &slot = ts_get_slot(date, worker_id);
//
//   // 1. Thread-local bitset 追踪: O(1) 检查是否首次写入
//   //    优化: 避免每次都检查 unordered_set (O(log N))
//   static thread_local vector<vector<bool>> asset_written(num_ts_workers_);
//   if (asset_written[worker_id].empty()) [[unlikely]] {
//     asset_written[worker_id].resize(num_assets_, false);
//   }
//
//   if (!asset_written[worker_id][asset_id]) [[unlikely]] {
//     asset_written[worker_id][asset_id] = true;
//     assigned_assets_[worker_id].insert(asset_id);  // 全局记录 (用于 ts_done)
//   }
//
//   // 2. 更新 per-asset 写入位置 (memory_order_release)
//   //    release: 确保 TS_WRITE_* 的数据写入对后续 CS acquire 可见
//   size_t new_pos = l0_time_index + 1;
//   slot.ts_write_pos[asset_id].store(new_pos, memory_order_release);
//
//   // 3. 增量维护 worker_min (thread-local 缓存)
//   static thread_local vector<size_t> worker_local_min;
//   if (worker_local_min.empty()) [[unlikely]] {
//     worker_local_min.resize(num_ts_workers_, SIZE_MAX);  // 初始化为 SIZE_MAX
//   }
//
//   size_t old_min = worker_local_min[worker_id];
//
//   // 4. 条件发布优化: 只有当 new_pos <= old_min 时才需要更新 worker_min
//   //    如果 new_pos > old_min, 说明当前 asset 在前面, 不影响 min, 跳过发布
//   if (new_pos <= old_min) {
//     // 当前 asset 可能是瓶颈, 重新扫描所有已写 assets
//     size_t new_min = SIZE_MAX;
//     for (size_t a : assigned_assets_[worker_id]) {
//       new_min = std::min(new_min, slot.ts_write_pos[a].load(memory_order_relaxed));
//     }
//     worker_local_min[worker_id] = new_min;
//     // 发布新的 worker_min (memory_order_release)
//     slot.ts_worker_min_pos[worker_id].store(new_min, memory_order_release);
//   }
//   // else: fast asset, 不影响 worker_min, 跳过发布 (huge optimization!)
//
//   // 5. CS 通过扫描 min(ts_worker_min_pos[all workers]) 判断 time_idx 就绪
//   //    扫描复杂度: O(W) vs O(A), W=10, A=1000, 快 100 倍
// }
//
// === TS Worker: 完成标记 ===
// void ts_done(date, worker_id) {
//   Slot &slot = ts_get_slot(date, worker_id);
//   const size_t final_progress = MAX_ROWS_PER_LEVEL[0];  // L0 最大 time_idx
//
//   // 1. 批量更新所有实际写过的 asset 位置为最终值 (使用 relaxed 提高性能)
//   //    动态记录机制: 只更新实际写过的 assets, 无需预知分配
//   for (size_t a : assigned_assets_[worker_id]) {
//     slot.ts_write_pos[a].store(final_progress, memory_order_relaxed);
//   }
//
//   // 2. 插入 release fence 确保上述写入对后续 acquire 可见
//   //    关键: release fence 建立 happens-before 关系
//   //    CS 的 acquire load 能看到 fence 之前的所有 relaxed store
//   std::atomic_thread_fence(memory_order_release);
//
//   // 3. 发布最终 worker_min_pos (确保 CS 快速扫描时不会阻塞)
//   slot.ts_worker_min_pos[worker_id].store(final_progress, memory_order_release);
//
//   // 4. 最后标记该 worker 完成 (memory_order_release)
//   //    CS 通过 acquire 读取此 flag, 建立同步点
//   assert(!slot.ts_done_flag[worker_id].load(memory_order_acquire) && "TS worker already marked done");
//   slot.ts_done_flag[worker_id].store(true, memory_order_release);
//
//   // 5. 清除 cache (避免 stale access, 防止后续误用)
//   ts_cache_[worker_id] = {"", SIZE_MAX, 0};
// }
//
// === CS Worker: 等待 time_idx 就绪 (two-level position sweep) ===
// void cs_wait(date, l0_time_index) {
//   // Step 1: 获取 Slot (cache hit 或轮询 date_to_slot_)
//   Slot *slot = nullptr;
//   if (cs_cache_.date == date && cs_cache_.slot_idx < pool_size_) [[likely]] {
//     Slot &s = pool_[cs_cache_.slot_idx];
//     if (s.epoch.load(memory_order_acquire) == cs_cache_.epoch) {
//       slot = &s;  // Cache hit
//     }
//   }
//
//   if (!slot) {
//     // Cache miss: 轮询等待 TS 分配并 publish BUSY 状态
//     while (!slot) {
//       {
//         lock_guard<mutex> lock(pool_mutex_);
//         auto it = date_to_slot_.find(date);
//         if (it != date_to_slot_.end()) {
//           size_t slot_idx = it->second;
//           Slot &s = pool_[slot_idx];
//           TensorState state = s.state.load(memory_order_acquire);
//           if (state == BUSY || state == DONE) {
//             slot = &s;
//             cs_cache_.date = date;
//             cs_cache_.slot_idx = slot_idx;
//             cs_cache_.epoch = s.epoch.load(memory_order_acquire);
//           }
//         }
//       }
//       if (!slot) {
//         sleep_for(microseconds(100));
//       }
//     }
//   }
//
//   // Step 2: Fast path - cs_read_pos cache
//   //   cs_read_pos = N 表示 [0, N-1] 已验证就绪
//   if (l0_time_index < slot->cs_read_pos.load(memory_order_relaxed)) [[likely]] {
//     return;  // Cache hit
//   }
//
//   // Step 3: Slow path - 扫描 ts_worker_min_pos (O(W) 扫描)
//   size_t backoff_us = 1;
//   while (true) {
//     // 3a. 扫描所有 worker 的 min_pos
//     size_t min_pos = SIZE_MAX;
//     for (size_t w = 0; w < num_ts_workers_; ++w) {
//       min_pos = std::min(min_pos, slot->ts_worker_min_pos[w].load(memory_order_acquire));
//     }
//
//     // 3b. 如果 min_pos > l0_time_index, time_idx 就绪
//     if (min_pos > l0_time_index) {
//       slot->cs_read_pos.store(min_pos, memory_order_relaxed);  // 批量验证 [0, min_pos)
//       return;
//     }
//
//     // 3c. 检查所有 TS worker 是否完成 (无更多进度)
//     bool all_done = true;
//     for (size_t w = 0; w < num_ts_workers_; ++w) {
//       if (!slot->ts_done_flag[w].load(memory_order_acquire)) {
//         all_done = false;
//         break;
//       }
//     }
//     if (all_done) {
//       slot->cs_read_pos.store(MAX_ROWS_PER_LEVEL[0], memory_order_relaxed);  // 强制所有就绪
//       return;
//     }
//
//     // 3d. Exponential backoff
//     sleep_for(microseconds(backoff_us));
//     backoff_us = std::min(backoff_us * 2, 100UL);
//   }
// }
//
// === CS Worker: 获取 slot (cache + 轮询) ===
// Slot& cs_get_slot(const string& date) {
//   // Fast path: cache hit with epoch validation
//   if (cs_cache_.date == date && cs_cache_.slot_idx < pool_size_) [[likely]] {
//     Slot &s = pool_[cs_cache_.slot_idx];
//     if (s.epoch.load(memory_order_acquire) == cs_cache_.epoch) {
//       return s;  // Cache valid
//     }
//   }
//
//   // Slow path: cache miss or epoch mismatch
//   lock_guard<mutex> lock(pool_mutex_);
//   auto it = date_to_slot_.find(date);
//   assert(it != date_to_slot_.end() && "CS accessing non-existent date");
//
//   size_t slot_idx = it->second;
//   Slot &s = pool_[slot_idx];
//   TensorState state = s.state.load(memory_order_acquire);
//   assert((state == BUSY || state == DONE) && "CS accessing wrong state");
//
//   cs_cache_.date = date;
//   cs_cache_.slot_idx = slot_idx;
//   cs_cache_.epoch = s.epoch.load(memory_order_acquire);
//
//   return s;
// }
//
// === CS Worker: 完成标记 ===
// void cs_done(date) {
//   // 1. 从 cache 获取 slot
//   assert(cs_cache_.date == date && cs_cache_.slot_idx < pool_size_ && "CS cache mismatch");
//   Slot &slot = pool_[cs_cache_.slot_idx];
//
//   // 2. 等待所有 TS worker 完成 (确保不会有新数据写入)
//   //    使用 exponential backoff 避免 busy-loop
//   size_t backoff_us = 1;
//   while (true) {
//     bool all_done = true;
//     for (size_t w = 0; w < num_ts_workers_; ++w) {
//       if (!slot.ts_done_flag[w].load(memory_order_acquire)) {
//         all_done = false;
//         break;
//       }
//     }
//     if (all_done) break;
//
//     sleep_for(microseconds(backoff_us));
//     backoff_us = std::min(backoff_us * 2, 100UL);  // 指数增长, 最大 100us
//   }
//
//   // 3. Atomic state transition BUSY → DONE
//   {
//     lock_guard<mutex> lock(pool_mutex_);
//     TensorState expected = BUSY;
//     bool success = slot.state.compare_exchange_strong(
//         expected, DONE,
//         memory_order_acq_rel, memory_order_relaxed);
//     assert(success && "CS state transition failed");
//   }
//
//   // 4. 清除 cache (防止后续误用)
//   cs_cache_ = {"", SIZE_MAX, 0};
// }
//
// === CS Worker: 辅助函数 ===
// _Float16* cs_read(Slot &s, size_t lvl, size_t t, size_t f) {
//   // 返回指向 (lvl, t, f) 的所有 A 个 assets 的指针
//   // 调用前确保 cs_wait(date, t) 已验证 time_idx t 就绪
//   const size_t F = FIELDS_PER_LEVEL[lvl];
//   const size_t A = num_assets_;
//   return &s.data[lvl][(t * F + f) * A];
// }
//
// void cs_write(Slot &s, size_t lvl, size_t t, size_t f, const _Float16* src, size_t count) {
//   // 写入 (lvl, t, f) 的前 count 个 assets
//   const size_t F = FIELDS_PER_LEVEL[lvl];
//   const size_t A = num_assets_;
//   memcpy(&s.data[lvl][(t * F + f) * A], src, count * sizeof(_Float16));
// }
//
// 注: 实际使用建议通过 CS_READ_ALL/CS_WRITE_ALL 宏访问, 更高效
//
// === IO Worker: 主循环 (扫描 date_to_slot_) ===
// bool io_try_flush_one() {
//   string date_to_flush;
//   size_t slot_idx = pool_size_;
//
//   // 1. 扫描 date_to_slot_, 找到第一个 DONE slot 并转换为 FLUSH
//   {
//     lock_guard<mutex> lock(pool_mutex_);
//     for (const auto &[date, idx] : date_to_slot_) {
//       TensorState expected = DONE;
//       if (pool_[idx].state.compare_exchange_strong(
//               expected, FLUSH,
//               memory_order_acq_rel, memory_order_relaxed)) {
//         date_to_flush = date;
//         slot_idx = idx;
//         break;
//       }
//     }
//   }
//
//   // 2. 没有 DONE slot, 返回 false
//   if (slot_idx >= pool_size_) {
//     return false;
//   }
//
//   Slot &slot = pool_[slot_idx];
//
//   // 3. 拷贝 date (避免写盘期间 slot 被修改)
//   char date_copy[16];
//   strncpy(date_copy, slot.date, sizeof(date_copy));
//   date_copy[sizeof(date_copy) - 1] = '\0';
//
//   // 4. 写盘 (昂贵操作, 不持有锁)
//   write_to_disk(date_copy, &slot);
//
//   // 5. 清理: 删除 date_to_slot_ 映射
//   {
//     lock_guard<mutex> lock(pool_mutex_);
//     date_to_slot_.erase(date_copy);
//   }
//
//   // 6. 使 epoch 失效并回收 slot
//   slot.epoch.fetch_add(1, memory_order_acq_rel);  // 使所有 cache 失效
//   slot.state.store(FREE, memory_order_release);   // 发布 FREE 状态
//   push_free(slot_idx);                            // CAS 无锁压栈
//
//   return true;
// }
//
// 使用示例:
//   while (running) {
//     if (!io_try_flush_one()) {
//       sleep_for(milliseconds(10));  // 没有工作, 休眠
//     }
//   }
//
// === 无锁 Freelist 操作 (Tagged pointer 防 ABA) ===
// int pop_free() const {
//   while (true) {
//     uint64_t head_tagged = free_head_.load(memory_order_acquire);
//     int head_idx = static_cast<int>(head_tagged & 0xFFFFFFFF);
//     uint32_t head_tag = static_cast<uint32_t>(head_tagged >> 32);
//
//     // Empty or corrupted
//     if (head_idx < 0 || head_idx >= static_cast<int>(pool_size_)) {
//       return -1;
//     }
//
//     int next_idx = pool_[head_idx].next_free.load(memory_order_relaxed);
//     uint64_t next_tagged = (static_cast<uint64_t>(head_tag + 1) << 32) |
//                            (next_idx >= 0 ? static_cast<uint32_t>(next_idx) : 0xFFFFFFFFU);
//
//     uint64_t expected = head_tagged;
//     // CAS: success 用 acq_rel (获取旧 head, 发布新 head, tag+1 防 ABA)
//     if (free_head_.compare_exchange_weak(expected, next_tagged,
//                                          memory_order_acq_rel)) {
//       return head_idx;  // 成功弹出
//     }
//     // CAS 失败 (被其他线程修改或 ABA), 重试
//   }
// }
//
// void push_free(int slot_idx) const {
//   while (true) {
//     uint64_t old_head_tagged = free_head_.load(memory_order_acquire);
//     int old_head_idx = static_cast<int>(old_head_tagged & 0xFFFFFFFF);
//     uint32_t old_tag = static_cast<uint32_t>(old_head_tagged >> 32);
//
//     pool_[slot_idx].next_free.store(old_head_idx, memory_order_relaxed);
//     uint64_t new_head_tagged = (static_cast<uint64_t>(old_tag + 1) << 32) |
//                                static_cast<uint32_t>(slot_idx);
//
//     uint64_t expected = old_head_tagged;
//     // CAS: success 用 acq_rel (获取旧 head, 发布新 head, tag+1 防 ABA)
//     if (free_head_.compare_exchange_weak(expected, new_head_tagged,
//                                          memory_order_acq_rel)) {
//       return;  // 成功压入
//     }
//     // CAS 失败 (被其他线程修改或 ABA), 重试
//   }
// }
//
// ============================================================================
// MEMORY ORDER SUMMARY (关键操作的 memory_order 选择)
// ============================================================================
//
// 操作                             Memory Order         理由
// ---------------------------------------------------------------------------------
// epoch.fetch_add                  acq_rel             同步 slot 失效, 双向可见性
// state.store(INIT)                relaxed             持有 pool_mutex_, 无需额外同步
// state.store(BUSY)                release             发布 slot 初始化完成 (在 reset 后)
// state.store(FREE)                release             发布 slot 回收完成
// state.load                       acquire             获取 slot 状态并同步数据
// state.compare_exchange_strong    acq_rel, relaxed    状态转换需要双向同步
// ts_write_pos[a].store(0)         relaxed             reset 中初始化, 后续 release fence 建立同步
// ts_write_pos[a].store(new_pos)   release             发布数据写入完成 (TS_WRITE_* → store pos)
// ts_write_pos[a].load             relaxed             TS worker 内部读取 (无竞争, 单写者)
// ts_worker_min_pos[w].store(0)    relaxed             reset 中初始化
// ts_worker_min_pos[w].store(min)  release             发布 worker 最小位置 (条件发布优化)
// ts_worker_min_pos[w].load        acquire             CS 读取 worker min 并同步
// ts_done_flag[w].store(false)     relaxed             reset 中初始化
// ts_done_flag[w].store(true)      release             发布 worker 完成状态
// ts_done_flag[w].load             acquire             读取完成状态并同步
// cs_read_pos.store                relaxed             单 CS worker 独占写, 无竞争
// cs_read_pos.load                 relaxed             单 CS worker 独占读, 无竞争
// free_head_ CAS (tagged)          acq_rel             Freelist pop/push 双向同步 + ABA 防护
//                                                      格式: (tag << 32) | idx, tag++ 防 ABA
// atomic_thread_fence              release             ts_done 批量发布 relaxed stores
//
// ============================================================================
//
// 【时间映射】L0 ↔ L1/L2
//   - L0 包含 _link_to_L1, _link_to_L2 两个 META feature
//   - 存储为 _Float16,值为 L1/L2 时间索引
//   - 支持非均匀映射 (多个 L0 tick 指向同一 L1 minute)
//
// 【导出格式】输出目录: output/features/YYYY/MM/DD/
//   - features_L0.bin: [T0, F0, A] (包含 link features)
//   - features_L1.bin: [T1, F1, A]
//   - features_L2.bin: [T2, F2, A]
//
// 【Public API 速查】
//
// TS Worker:
//   ts_update(date, worker_id, asset_id, l0_time_index)  更新时间进度 (写入后调用)
//   ts_done(date, worker_id)                             完成标记
//   TS_WRITE_FEATURES(store, date, lvl, t, a, f_start, f_end, src, worker_id)  批量写特征(只查询一次, 更快, 优先用)
//   TS_WRITE_SINGLE(store, date, lvl, t, f, a, value, worker_id)               单个写特征
//
// CS Worker:
//   cs_wait(date, l0_time_index)                         等待 time_idx 就绪
//   CS_READ_ALL(store, date, lvl, t, f) → _Float16*      读取所有 assets
//   CS_WRITE_ALL(store, date, lvl, t, f, src, count)     写入所有 assets
//   cs_done(date)                                        完成标记
//
// IO Worker:
//   io_try_flush_one() → bool                            尝试 flush 一个 DONE slot
//
// Internal (private):
//   ts_get_slot(date, worker_id) → Slot&                 TS worker 获取 slot (cache + epoch)
//   cs_get_slot(date) → Slot&                            CS worker 获取 slot (cache + epoch)
//   pop_free() → int                                     弹出空闲 slot (lock-free CAS)
//   push_free(slot_idx)                                  压入空闲 slot (lock-free CAS)
//
// 元数据查询:
//   query_F(lvl), query_A(), query_T(lvl), query_cs_worker_id(), query_io_worker_id()
//
// ============================================================================
