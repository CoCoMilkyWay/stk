│   │   ├── factor/                                         # 🧬 因子算子基建: 因子 = 特征的 TS / CS 算子组合; Stat = 因子评估器 (不入 OpTable)
│   │   │   │                                               #    · 分层: 算子核 (无线程 / 无分配) → 流程 run<Exec> → 应用层管线程 / 内存
│   │   │   │                                               #    · 并行: 搜索 = 因子间 (每线程 Serial); 交互 = 因子内 (ForkJoin)
│   │   │   │                                               #    · 一致: stream 后端为 golden (对拍带容差); 序统计 / Stat 用整数计数, 逐位一致
│   │   │   ├── Contract.hpp                                # 🧬 TS / CS 语义契约 (三后端共享)
│   │   │   │                                               #    · 形状: T 窗 × A 域 × 核类; SoA [T][A]; 段长 S = 本层每段行数 (运行期量)
│   │   │   │                                               #    · 调用形状: 三后端同一个 Call (x / y / z / o + 池掩码 g + T×A + 层几何 + 参数); 架构只认这一个形状
│   │   │   │                                               #    · 暂存: 调用方持有 (scratch 声明字节, Bump 切分), 算子内部不分配
│   │   │   │                                               #    · Fuse: 逐点链融合程序 (≤ kFuseIn 输入 / ≤ kFuseLen 步)
│   │   │   │                                               #    · 规矩: branchless; 退化给中性值; 掩码只表示输入有效性
│   │   │   ├── OpTable.hpp                                 # 🧬 算子真相表 X-macro: 命名 域_核_窗, 三后端同名展开; 行序 = 全局 idx; Stat 不入表
│   │   │   │                                               #    · in 列逐元 Dom (REAL / NONNEG / POS / UNIT / SIGNED / BIN / SIGN3 / INT / BCAST / RET); 对拍输入配方由它推
│   │   │   ├── Expr.hpp                                    # 🧬 因子表达式 解析 / 序列化: 前缀式 ↔ 树 + 静态校验
│   │   │   │                                               #    · 裸键名 d / k / k2 = 自由参数 (模板 vs 具体实例, 见 instance_of)
│   │   │   │                                               #    · 不合法是正常输入: 返回 false + 原因, 不断言
│   │   │   ├── Dag.hpp                                     # 🧬 Expr → 去重 DAG + 槽复用计划; 多 Expr 合一 (跨因子共享); 只管结构, 不管并行
│   │   │   │                                               #    · fuse (默认开): 单消费者的逐点 (POINT × SELF) 链并成一个融合节点, 中间量不落平面
│   │   │   ├── EvalCpu.hpp                                 # 🧬 DAG 的 CPU evaluator + 宿主槽池 HostPool
│   │   │   │                                               #    · 切法只看 A 域, 与单线程逐位一致: TS 按 kTileA 列 / CS 按行 / 融合按 kFuseRows 行块
│   │   │   ├── EvalGpu.hpp                                 # 🧬 DAG 的 GPU evaluator + 设备槽池 DevPool (头文件无 CUDA 依赖; 中间量不落宿主; 融合节点 run_fused 一核跑完)
│   │   │   ├── StreamHist.hpp                              # 🧬 流式后端分桶直方图 (序统计族)
│   │   │   ├── Check.hpp                                   # 🧬 TS / CS 对拍公共件
│   │   │   ├── GpuRun.hpp                                  # 🧬 GPU 宿主接口 (POD 指针); 未开 CUDA 为 stub
│   │   │   ├── TS/                                         # 🧬 时序算子三后端 (同名 struct, 缺一编译错)
│   │   │   │   ├── Stream.hpp                              # 🧬   实盘流式: 逐点因果, O(d) 状态, 单资产推进 (一资产一个对象, step 逐点推)
│   │   │   │   ├── Cpu.hpp                                 # 🧬   挖掘 CPU: 整张量向量化批算, 吞吐 ≥ stream; 有状态算子按 kTileA 列块推进 (状态驻 L1/L2)
│   │   │   │   └── Gpu.cuh                                 # 🧬   挖掘 GPU: CUDA, 吞吐 ≥ CPU
│   │   │   ├── CS/                                         # 🧬 截面算子三后端 (与 TS 同构, 三份独立实现)
│   │   │   │   └── Stream.hpp / Cpu.hpp / Gpu.cuh          # 🧬   同上 (流式: 一个对象逐行推全部截面, 暂存是成员)
│   │   │   ├── Stat/                                       # 🧬 因子评估器 (无流式后端): 因子 + 标签 → Row[H][T] (IC / 分组 / 多空) → HoldStat
│   │   │   │   │                                           #    · 并列均秩 + 整数 Pearson ⇒ CPU ↔ GPU 逐位一致
│   │   │   │   ├── Contract.hpp                            # 🧬   语义契约: Row / HoldStat + 可合并累加器 + 换手成本 (Cost / CostAcc / cost_row / net_ls)
│   │   │   │   │                                           #      · 【协议表 1】持有期 (1m 5m 15m 30m 60m close T+1O T+1C T+2C T+3C) → 开仓 / 清仓 / 价
│   │   │   │   │                                           #      · 【协议表 2】开关仓策略: 可成交判据 / 建仓作废 / 平仓顺延 / 仓位 1/h̄ / 换手 Δw / 成本 / 净值
│   │   │   │   │                                           #      · 成本口径: Δw (同一价点才交接); 尾部行 (tail_masked) 不开仓不攒; Run / Inspect / Portfolio 同一份, Search 不看
│   │   │   │   ├── Host.hpp                                # 🧬   行核宿主版: rank_row / row_stat / cost_row (Stat / Search 的 CPU 后端共用)
│   │   │   │   ├── Dev.cuh                                 # 🧬   行核设备版: 与 Host.hpp 同名同参序 (Stat / Search 的 GPU 后端共用)
│   │   │   │   ├── Check.hpp                               # 🧬   对拍公共件
│   │   │   │   ├── Cpu.hpp                                 # 🧬   CPU 后端: 行区间核 + 流程
│   │   │   │   └── Gpu.cuh                                 # 🧬   GPU 后端: 一 warp 一行 t (持有期在 warp 内串行)
│   │   │   └── Search/                                     # 🧬 参数搜索评估 (建在 Stat 上): 一批同形候选直接攒累加器, 不落 Row
│   │   │       ├── Contract.hpp                            # 🧬   语义契约: 分块流式 + 目标函数 + 噪声 + 终选
│   │   │       │                                           #      · 目标 = 固定 h 的 ls_period · rIC; 任一 ≤ 0 → −∞; 不看成本, 不跨 h 比
│   │   │       │                                           #      · ls_period = 每期真实毛多空 (持仓口径: 触发率 / 资金利用率已在内, 不另设活跃度项)
│   │   │       │                                           #      · 噪声 = 解析标准误 (按 n/h 有效样本); 终选 pick_diverse 只认统计量, 无个数 / 相关上限
│   │   │       ├── Space.hpp                               # 🧬   参数空间 (纯逻辑): 可搜槽 → 单调坐标 + 区间 (由已有常数推出; 阈值按输入分位) → R_d 采样
│   │   │       ├── Surface.hpp                             # 🧬   曲面 (纯逻辑): 已评点 → 高斯过程 (噪声 = 各点标准误) → 后验 / 峰
│   │   │       ├── Cpu.hpp                                 # 🧬   CPU 后端: 复用 Stat 行核 (Host.hpp), 只加块语义与累加
│   │   │       ├── Gpu.cuh                                 # 🧬   GPU 后端: 一 warp 一候选
│   │   │       └── Check.hpp                               # 🧬   对拍公共件 (参考 = Stat CPU)
│   │   ├── math/                                           # 📐 distribution / normalize / sample / spectral / stationary / timeseries / autoencoder / model
│   │   │   ├── Step.hpp                                    # 📐 变换步元数据 / 定义 (ParamMeta / StepDef → Step, 编译期注册)
│   │   │   ├── sample/ResamplerTick2Min / ResamplerBar2Min # 📐 两档重采样器: 逐笔 / bar1m → 稠密分钟 K (255 根; 无成交分钟用携带价补齐)
│   │   │   ├── sample/ResamplerMin2Bin                     # 📐 分钟 K → 本层 bar (分钟箱层 + L_1day 整日箱, 两档共用)
│   │   │   ├── stationary/TodProfile.hpp                   # 📐 日内轮廓去季节 (TodSub / TodZ, expanding 因果)
│   │   │   └── spectral/IIRBandpass.hpp                    # 📐 因果 IIR 带通
│   │   ├── api/                                            # 🌐 数据源 API: 纯传输, 不知 Spec; 两客户端对仗 (query → arrow::Table)
│   │   │   ├── bigquant/client.hpp                         # 🌐 BigQuant DAI: query(Query{sql, filters}) / quota
│   │   │   └── tushare/client.hpp                          # 🌐 Tushare HTTP: query(Query{api, params, num})
│   │   ├── fundamental/                                    # 📊 日频基本面数据集: 两数据源同一套; 只单向依赖 api
│   │   │   ├── Spec.hpp                                    # 📊   表定义 SPECS: Shape × snap × src (Bq / Tu); 静态初始化期全表断言
│   │   │   ├── Store.hpp                                   # 📊   本地: Catalog (一次目录遍历) + 分片状态 + 拉取计划 + put (时间只经 Now)
│   │   │   ├── Remote.hpp                                  # 📊   远端: fetch(client, task), 两源同骨架 (queries → query → concat → drop); DAI SQL 只在 select 构造
│   │   │   ├── Sync.hpp                                    # 📊   写侧: plan<Src> → sync(client, tasks) = put(t, fetch(client, t))
│   │   │   ├── Scan.hpp                                    # 📊   读侧: 分段并行 map-reduce + meta / daily / calendar (AssetInfo / fund::Panel / Bar1mDay 共用)
│   │   │   └── Audit.hpp                                   # 📊   核对: 远端指纹 ↔ 本地指纹 (仅 DAI 冻结月 / 冻结日)
│   │   ├── mining/                                         # ⛏️ 数据挖掘设计文档 (特征 → 因子)
│   │   └── misc/                                           # 🔧 通用工具库
│   │       ├── logging.hpp / print.hpp                     # 🔧 日志 / STL 容器格式化打印
│   │       ├── format.hpp                                  # 🔧 定宽数值格式化 (UI 表格 / 日志对齐)
│   │       ├── timer.hpp / profiler.hpp                    # 🔧 计时器 / 性能剖析
│   │       ├── progress_single.hpp / progress_parallel.hpp # 🔧 单行 / 多线程进度条
│   │       ├── exec.hpp                                    # 🔧 执行器 (全仓唯一批内并行抽象): Serial / ForkJoin 逐位一致; 接口 rows(t0, t1, tid) / tasks(i, tid); 线程数 hw() / fit(n)
│   │       ├── affinity.hpp                                # 🔧 CPU 亲和性
│   │       ├── archive.hpp / parquet.hpp                   # 🔧 归档操作 / Parquet 读写
│   │       ├── fs.hpp / file_check.hpp                     # 🔧 文件系统 / 归档完整性校验
│   │       ├── date.hpp / cross_platform.hpp               # 🔧 Ymd / Ym (int32) 日历运算 / Win-Linux-Mac 兼容层
│   │       ├── system_metrics.hpp                          # 🔧 系统监控采集 (CPU / 内存 / 磁盘)
│   │       └── VariableMonitor.hpp                         # 🔧 变量值监控
│   ├── src/                                                # 💾 源文件实现 (对应 include/)
│   │   ├── main.cpp                                        # 💾 程序入口
│   │   ├── factor/op_check.cpp                             # 💾 三后端对拍 CLI (独立 target); 末节 Fuse: 随机表达式树, 融合 ≡ 不融合 (--op Fuse 单跑)
│   │   ├── factor/op_check_gpu.cu                          # 💾 GPU 后端 CUDA 实现 (GPU_BACKEND=CUDA 时入链)
│   │   ├── factor/op_check_gpu_stub.cpp                    # 💾 GPU stub (未开 CUDA)
│   │   ├── {api,fundamental,codec,shared,misc,features}/   # 💾 对应模块实现
│   │   │                                                   #    · features/FeatureMeta.cpp: 字段表元数据唯一 TU (增删特征 GUI 不重编)
│   │   ├── worker/{lob,bar}_pipeline.cpp                   # 💾 两档的源 TierFeed + pipeline<T> 实例化 (Lob fast-math / Bar precise-math)
│   │   ├── worker/{crosssectional_worker,io_worker}.cpp    # 💾 截面 cs_loop / 落盘 io_loop (档无关)
│   │   ├── worker/{feature_progress,encoding_worker}.cpp   # 💾 特征计算终端仪表盘 / 逐笔编码 worker
│   │   ├── gui/Gui.cpp / Tasks.cpp                         # 💾 GUI 主循环 / 任务注册
│   │   ├── gui/Run_OpenGL.cpp                              # 💾 OpenGL 后端入口
│   │   └── gui/Run_Vulkan.cpp                              # 💾 Vulkan 后端入口
│   ├── package/                                            # 📚 第三方库 (源码内置, header-only 直接 include)
│   │   ├── boost/                                          # 📚 asio / beast / optional
│   │   ├── nlohmann/ yyjson/ utfcpp/                       # 📚 JSON / 文本编解码
│   │   ├── zlib-1.3.1/ zstd-1.5.7/ arrow/                  # 📚 压缩 / Parquet 列式存储
│   │   ├── imgui/ implot/ glfw/                            # 📚 GUI 渲染
│   │   ├── microtex/ tinyxml2/                             # 📚 LaTeX 渲染 / XML 解析
│   │   └── tracy/                                          # 📚 性能剖析
│   ├── fonts/                                              # 🔤 GUI 字体
│   ├── script/                                             # 🐍 绘图脚本 (bookmap / plot_bars / plot_signals)
│   └── projects/main/                                      # 🏗️ 构建系统
│       ├── CMakeLists.txt                                  # 🏗️ CMake (C++23, Clang)
│       └── build/bin/app_main                              # 🎯 可执行文件
└── output/                                                 # 📁 运行时输出 (与 cpp/ 同级)
    ├── orders/                                             # Level-2 逐笔编码 (逐笔委托 + 成交合并)
    │   └── YYYY/MM/YYYYMMDD.bin                            # 一天全市场一个文件: 每资产一个 zstd 帧 + 账目 + 尾部目录
    ├── features/                                           # 特征张量库 (Float16); 一库一目录, 池名 = 目录名
    │   ├── <pool>/lib.json                                # 库清单 (档 / A 轴 / 日期轴): 写端规划后落, 读端只读; 无清单 = 未建库
    │   ├── <pool>/features.json                            # 特征表预览成品 (每轮落地)
    │   ├── <pool>/YYYY/MM/DD/                              # Lob 池 (池轴; <pool> = all 池的 pool_<pool> 列)
    │   │   ├── features_L_sec.bin                          # L_sec (秒频) 一天一个: 头 + 列目录 + 逐列载荷 [T×A]
    │   │   └── features_L_1min.bin                         # L_1min (分钟频) 一天一个: 同上; 两层都逐列自选是否做 T 轴 XOR 差分
    │   └── all/YYYY/MM/DD/features_L_*.bin                 # Bar 池 (全轴, L_1min + 分钟箱层 + L_1day; 目录名 all 保留给它)
    ├── fundamental/                                        # 日频基本面 (表清单见 DataBase → Overview)
    │   ├── YYYY-MM/<表>.parquet                            # 月度分片 (每表一文件; 0 行月也落文件 = 拉过)
    │   ├── YYYY-MM/bar1m/YYYY-MM-DD.parquet                # 分钟 K 日分片 (Bar 档 TS 输入, 不复权)
    │   ├── _meta/<表>.parquet                              # Static / Snapshot 单文件整刷
    │   └── asset_axis.json                                 # A 轴 (资产轴) 码表, 只增不删
    ├── doc/                                                # 文档 / 资料 (resources-* 符号链接指向仓库外 ../doc)
    │   ├── checked.md                                      # 研报因子库勾选清单
    │   ├── resources-raw -> ../../../doc/resources-raw     # 原始资料 (公众号 / paper / report / web)
    │   ├── resources-proc -> ../../../doc/resources-proc   # 加工后 (.stat 重算 + markdown 转换)
    │   └── resources-tag -> ../../../doc/resources-tag     # 标注后 (标签体系 + 统计, 给 agent)
    ├── factors/                                            # 因子库 (factor/ 的落地)
    │   ├── operators.json                                  # 算子表快照 (对拍 + 耗时), 与当前 OpTable 不符则重算
    │   └── <pool>/<层>/                                    # 因子文件 (一因子一文件, 可手写); <pool> = 该层所在档的当前池, <层> = min (Lob) / 5min / 15min / 30min / 60min / day (Bar)
    │       ├── log/<name>.log                              # Search 过程日志 (每次覆盖)
    │       └── *.json                                      # 因子文件字段:
    │                                                       #    · 必填: type / name_cn / expr (模板, 自由参数用裸键名)
    │                                                       #    · 可选: note / run / hold_cols / acc_cols
    │                                                       #    · weights: [{hold, sign?, expr (具体)}]; Search 整体替换, 改 expr 即清空
    │                                                       #    · stats: [stat | null], 与 weights 同序
    └── log/                                                # 运行日志
```

# ================================================
# 加新特征 Guideline (加特征 = 改 / 新建一个节点文件, 其他地方不动)
# ================================================
#
# 动手前必读 (按序):
#   1. cpp/include/features/FeaturesDefine.hpp   NODE_ / FIELDS_ 宏格式 + 公式符号规范 (索引 τ/c/j/i/t/D; P 价格族; O 订单流; ε 容差)
#   2. cpp/include/features/DataDefine.hpp       节点契约 (enum Out / y[] / compute / flush / reset) + Trigger 触发域 + 输入红线 (只准本资产数据 + 日频 PIT)
#   3. cpp/include/features/Node/unused/         想要的节点可能已有半成品
#   4. 同类现有节点 1-2 个作模板 (命名 / 公式 / 注释风格照抄):
#        - 累计降频型:   Node/Lob/TS/OrderFlow/Flow.hpp
#        - 盘口时间加权: Node/Lob/TS/Book/Book.hpp
#        - 分钟采样型:   Node/Common/Basic/Kline.hpp + Node/{Lob,Bar}/TS/Basic/Kline.hpp
#        - 日频型:       Node/Common/Fund/Fund.hpp + Node/Bar/TS/Fund/Fund.hpp (onSettle; Series 跨天保留, 盘中读 back() = 当日适用值)
#                        (Lob 档的 Fund 节点只供盘中节点取前收 / 涨跌停, 不落盘)
#        - 截面列:       Node/Bar/CS/Fund/Valuation.hpp
#        - 池列:       Node/Bar/CS/Pool/Pool.hpp
#
# 加在哪 (先定档: 要逐笔 / 盘口 → Lob; 只要分钟 K + 基本面 → Bar):
#   - 时序列:   Node/<Tier>/TS/<分类>/<Name>.hpp
#       · 内容: 节点类 (纯数学) + 文件末尾 NODE_<Name> (节点) + FIELDS_<LVL>_<Name> (落盘列, LVL = L_sec / L_1min / L_5min / L_15min / L_30min / L_60min / L_1day; 本身日频的列放 L_1day)
#       · 触发域: 降频型 onTick + onMinute; 分钟箱型 on<n>Min; 日型 onClose (读 day_data 整日 K); 盘后型 onSettle (日频 PIT 推进到次日)
#       · 行末源标: TS(<节点>[, <口>], Tf, Method)
#   - 截面列:   Node/<Tier>/CS/<分类>/<源节点>.hpp
#       · 内容: 只有 FIELDS_ 行; owner 名 Cs<源节点>; 方法在 Method/CS.hpp
#       · 行末源标: CS(<源档>, <层>, <源列>, Tf, Method); <层> 任意: 源行 = level_asof(<层>, 本层, t)
#         (粗层读已收的上一行; 落到前一交易日只许 TS / 元列, 区间首日 NaN)
#   - 两档都要: 节点类放 Node/Common/<分类>/, 两档各写各的 NODE_ / FIELDS_
#       · TS / CS 列名跨档不许重名 (FeatureMeta.cpp 编译期断言); Lob K 线用 lob_* 前缀
#   - 新池:   Node/Bar/CS/Pool/Pool.hpp 加一列 pool_<pool> = 多一个 Lob 池 <pool>
#       · 键不够就在 Node/Bar/TS/Pool/PoolKey.hpp 加
#   - 其他文件一律不改: CMake 按档扫描 Node/<Tier>/{TS,CS} → 拓扑排序 → 生成 <Tier>/NodesGenerated.hpp + FieldsGenerated.hpp
#
# 规矩:
#   - 分档: 同一列只在一档算; Lob 要基本面就截面旁读 Bar (TIER_SIDES, 任意层); 时序不跨档
#   - 复用: 只依赖同档上游节点, 不重复计算
#       · 盘口 → Depth.*; 逐笔成交 Δln p → TakerRet.out(); 涨跌停 → Fund.out(Fund.lim_up / lim_dn); 中间价 / 微观价 → MidPrice / MicroPrice.out()
#       · 依赖必须字面写在 NODE_ 行 (CMake 按 "Up." 抽取, 不许藏进 helper 宏)
#   - 命名: {measure}_{event}_{side}_{qualifier}
#       · measure = amt / vol / n / qty (qty = 存量, vol = 流量); event = taker / maker / cancel; side = bid / ask; qualifier = 窗口 / 价位 / 阈值
#       · 单价位用 l5, 前 N 价位累计用裸 5; 缩写忌歧义
#   - 缺失: 一律 NaN, 不用 0; fast-math TU 不写 isnan, 无定义用位图 / 守卫显式表示
#   - 出错: 只用断言, 不做错误处理; 失败越早越好
#   - 重算: 改字段表 (含加列) = 落盘指纹变化, 旧特征文件读取即断言失败, 需全量重算
#       · 列名不变但口径变: 标签 kLabelSemver / L_1day 行 kDaySemver +1 (FeatureStoreConfig.hpp), 同样判废
