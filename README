│   │   │   ├── L2Validator.hpp                         # 🔄 逐笔数据准入校验 (编码期)
│   │   │   └── OrdersDay.hpp                           # 🔄 orders 日文件读写 (DayWriter ↔ DayReader) + 全库帧目录 OrdersCatalog
│   │   ├── features/                                   # 🧮 特征工程: 事件驱动, 回测与实盘逐值一致
│   │   │   │                                           #    两档 (TierId), 同一列只在一档算:
│   │   │   │                                           #    · Lob: Level-2 逐笔 → 订单簿还原 → L_sec 秒 + L_1min 分钟; 回测日历起
│   │   │   │                                           #    · Bar: bar1m 分钟 K + 日频基本面 → L_1min + L_5min … L_60min 分钟箱 + L_1day; 2015-01-01 起
│   │   │   │                                           #    库 = 池 × 档 (features/Storage/FeatureLib.hpp); TS 与池无关 (基本面全市场, 按全局 id 取), 各池只差 A 轴与 cs_valid
│   │   │   │                                           #    档间: 时序不跨档; 截面只许 Lob → Bar 旁读 (TIER_SIDES); TS / CS 列名跨档唯一 (Lob K 线加 lob_ 前缀)
│   │   │   │                                           #    标签: Bar 各层持有期收益; Lob 只落建仓冲击成本 lb_cost_*
│   │   │   │                                           #    L_1day 行 D = D 收盘后至 D+1 开盘前可知 (盘中读到的是前一交易日行)
│   │   │   │                                           #    库末日随源齐推进; 源缺尾日则停, 不以默认值落盘
│   │   │   ├── FeaturesDefine.hpp                      # 🧮 字段表格式 (NODE_ / FIELDS_ 行) + 元数据枚举
│   │   │   ├── TimeIndex.hpp                           # 🧮 时间索引: Clock ↔ L_sec ↔ L_1min → n 分钟箱 (首箱 = 竞价; L_1day 一日一行)
│   │   │   ├── DataDefine.hpp                          # 🧮 TickData / MinuteData / BinData + 节点契约 / 截面列契约
│   │   │   │                                           #    · 触发域: 盘中 onTick / onDepth / onMinute → 箱末 on<n>Min → 收盘 onClose → 盘后 onSettle
