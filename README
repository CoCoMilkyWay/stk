│   │   │   ├── timer.hpp / profiler.hpp                 # 🔧 计时器 / 性能剖析
│   │   │   ├── progress_single/parallel.hpp             # 🔧 单行/多线程进度条
│   │   │   ├── affinity.hpp / schedule.hpp              # 🔧 CPU亲和性 / 月度调度器 (bigquant+tushare共用)
│   │   │   ├── archive.hpp / parquet.hpp                # 🔧 归档操作 / Parquet读写
