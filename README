│   │   │   │   └── ui/                               # 🖥️ TabOverview (基本面同步) / TabBrowser / TabTable / TabEncode / CrossSectionAnalysis
│   │   │   ├── task_features/                        # 🖥️ 特征计算管理
│   │   │   │   ├── TaskFeatures.hpp                  # 🖥️ 特征任务主界面
│   │   │   │   ├── services/                         # 🖥️ 服务层
│   │   │   │   │   ├── ComputeService.hpp            # 🖥️ 特征计算
│   │   │   │   │   ├── StreamService.hpp             # 🖥️ 流式分析 worker 骨架 (CRTP)
│   │   │   │   │   ├── DistService.hpp               # 🖥️ 分布分析 (StreamService)
│   │   │   │   │   ├── TransformService.hpp          # 🖥️ 特征变换 (StreamService)
│   │   │   │   │   ├── PreviewService.hpp            # 🖥️ 特征表预览 (StreamService)
│   │   │   │   │   ├── OrderFlowService.hpp          # 🖥️ 订单流
│   │   │   │   │   └── CorrService.hpp               # 🖥️ 相关矩阵 / lead-lag (StreamService)
│   │   │   │   └── ui/                               # 🖥️ UI
│   │   │   │       ├── Common.hpp                    # 🖥️ 流式 tab 公共件
│   │   │   │       ├── TabFeature.hpp                # 🖥️ 特征表: 过滤 + 多选
