│   │   │   ├── Bar1mDay.hpp                            # 🧮 bar1m 日分片 → 稠密 [A][255] 分钟 K (Bar 档 TS 输入)
│   │   │   ├── CoreCs.hpp                              # 🧮 截面 (按档模板): 每拍 (Lob L_sec / Bar L_1min) 对收行的各层算截面列; 源行 = level_asof; 旁读档经读端同一 Source
│   │   │   ├── MetaFlag.hpp                            # 🧮 元列 (_meta) 编解码
│   │   │   ├── FeatureMeta.hpp                         # 🧮 字段表元数据 (各档各层的列 / 分类 / 依赖), 唯一 TU src/features/FeatureMeta.cpp
│   │   │   ├── OrderBook/                              # 🧮 限价订单簿引擎: LimitOrderBook (买卖盘维护 + 撮合) / LimitOrderBookDefine (订单 / 价位结构) / README 撮合反推与各市场行情口径笔记
│   │   │   ├── Sample/                                 # 🧮 重采样: 逐笔 / bar1m → 稠密分钟 K (Tick2Min / Bar2Min) → 本层 bar (Min2Bin); run bar
│   │   │   ├── Node/Lob/TS/<分类>/                     # 🧮 Lob 档节点: 节点类 + NODE_ / FIELDS_ 宏
│   │   │   ├── Node/Bar/{TS,CS}/<分类>/                # 🧮 Bar 档节点: TS 同上; CS = 截面列 (只有 FIELDS_ 行)
│   │   │   ├── Node/Common/<分类>/                     # 🧮 两档共用节点类 (只许 class + helper 宏, 不许 NODE_ / FIELDS_)
│   │   │   ├── Method/                                 # 🧮 TS.hpp / CS.hpp 时序 / 截面归一方法 (字段表 SRC 列引用)
│   │   │   ├── Panel/                                  # 🧮 日频面板 (TS / CS 的日频数据源, 两者对仗)
│   │   │   │   ├── Fund.hpp                            # 🧮 fund::Panel 日频 PIT 基本面 (全市场): 全交易日历 × 全局 A 轴 + 逐资产事件链; 市场收益 / 长窗量 / 估值史 (5 年分位 + 底档曲度) 预计算
│   │   │   │   ├── PoolSpec.hpp                        # 🧮 池参数 = 维表 (一维一张取值表): 风格 (含全市场 = 切片内全取) × 端 × 只数 × 周期 × 权重 (单选维) × ST / 板块 / 融资 (划分维) × 过滤 (次新 / 预警 / PB>0 / PE>0 / 分红稳定); 池表恒以全A 两池起头
│   │   │   │   │                                       #    · Spec = 单选维的下标 + 集合维的位集 (划分维 = 类之并, 过滤维 = 剔的项); 在市固定剔次日停牌 / 行业未知
│   │   │   │   │                                       #    · 池名 (目录名) = 各维段以 "." 连 (集合维各位以 "+" 连); 显示名 = 简称 + 权重后缀 (低β200.等), 同简称按池表序加 A / B / C…
│   │   │   │   │                                       #    · Grid = 各维勾选位集 (Style 页参数网格), specs_of 展开成一组 Spec (集合维 = 各位单独 + 整体; 过滤维另加不剔, 划分维不另测全)
│   │   │   │   ├── PoolSelect.hpp                      # 🧮 选池引擎: all.bar L_1day 日行 → 原料带 Strip (进程内一份, 增量补; 类号 / 行业 / 市值 / 后复权 grow) → 次序 Order → 逐行成员 (一组 Spec)
