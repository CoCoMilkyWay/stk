│   │   │   ├── ComputeGraph.hpp                      # 🧮 计算图 DAG (CMake 扫描算子文件生成 NodesGenerated.hpp)
│   │   │   ├── CoreSequential.hpp                    # 🧮 单资产时序: tick → L0 → L1 + 标签
│   │   │   ├── CoreCrosssection.hpp                  # 🧮 截面: L0 每秒 + L1 分钟
│   │   │   ├── MetaFlag.hpp                          # 🧮 _meta 列编解码 (消费端不依赖 Meta 算子)
│   │   │   ├── Operator/TS/                          # 🧮 时序算子: class + NODE_ / FIELDS_ 宏
│   │   │   ├── Operator/CS/                          # 🧮 截面算子: 只有 FIELDS_ 行
│   │   │   ├── Operator/unused/                      # 🧮 未启用半成品
│   │   │   ├── Method/                               # 🧮 CS / TS 变换方法 + Fundamental (日频 PIT 基本面源)
│   │   │   └── Backend/                              # 🧮 特征存储后端
│   │   │       ├── FeatureStoreConfig.hpp            # 🧮 写端: 字段表 → 编译期层表; codec 选型在此
│   │   │       ├── FeatureLevels.hpp                 # 🧮 读端运行时层表 (与字段表解耦, 增删特征不触发读侧重编)
│   │   │       ├── FeatureStore.hpp                  # 🧮 存储引擎: [T][F][A] Float16, worker 并发写
│   │   │       ├── FeatureRead.hpp                   # 🧮 读取引擎: 按列选读 (单日 / 多日); 删库与多 reader 并发安全
