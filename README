│   │   │   │  > SystemInfo[""/live]               │                                    │
│   │   │   │  > DataBase                          │ Overview / Encode / Table / Browser│
│   │   │   │  > Features                          │ Feature / Compute / Transform /    │
│   │   │   │                                      │ Dist / Corr / OrderFlow            │
│   │   │   │  > Factors                           │ Operators / Factors / Inspect      │
│   │   │   │  > Tools                             │ LaTeX                              │
│   │   │   │ Icon:                                │                                    │
│   │   │   │  |Network|FPS│                       │                                    │
│   │   │   └───────────────────────────────────────────────────────────────────────────┘
│   │   ├── factor/                                         # 🧬 因子算子基建: 因子 = 特征的 TS / CS 算子组合, Stat = 因子评估算子
│   │   │   │                                               #    分层: 算子核 (无线程 / 无分配) · 流程 run<Exec> · 线程 / 内存在应用层
│   │   │   │                                               #    并行: 搜索 = 因子间 (每 worker Serial), 交互 = 因子内 (ForkJoin)
│   │   │   │                                               #    stream 后端为 golden (对拍带容差); 序统计 / Stat 用整数计数求逐位一致
│   │   │   ├── Contract.hpp                                # 🧬 TS/CS 语义契约 (三后端共享): T 窗 × A 域 × 核类, SoA [T][A], 段 = L1 一日; branchless, 退化给中性值, 掩码只表输入有效性
│   │   │   ├── OpTable.hpp                                 # 🧬 算子真相表 X-macro (命名 域_核_窗), 三后端同名展开; 行序 = 全局 idx; Stat 不入表
│   │   │   ├── Expr.hpp                                    # 🧬 因子表达式 codec: 前缀式 ↔ 树 + 静态校验; 裸键名 d / k / k2 = 自由参数 (模板 vs 具体实例 instance_of); 不合法是正常输入 → false + 原因 (不断言)
│   │   │   ├── Dag.hpp                                     # 🧬 Expr → 去重 DAG + 槽复用计划; 多 Expr 合一 (跨因子共享); 只管结构, 不含并行
│   │   │   ├── Exec.hpp                                    # 🧬 执行器 (CPU 唯一并行抽象): Serial / ForkJoin, 核只写 fn(t0, t1, tid), 两者逐位一致
│   │   │   ├── EvalCpu.hpp                                 # 🧬 DAG 的 CPU evaluator + 宿主槽池
│   │   │   ├── EvalGpu.hpp                                 # 🧬 DAG 的 GPU evaluator (头文件无 CUDA 依赖) + 设备槽池, 中间量不落宿主
│   │   │   ├── StreamHist.hpp                              # 🧬 流式后端分桶直方图 (序统计族)
│   │   │   ├── Check.hpp                                   # 🧬 TS/CS 对拍公共件
│   │   │   ├── GpuRun.hpp                                  # 🧬 GPU 宿主接口 (POD 指针); 未开 CUDA 为 stub
│   │   │   ├── TS/                                         # 🧬 时序算子三后端 (同名 struct, 缺一编译错)
│   │   │   │   ├── Stream.hpp                              # 🧬   实盘流式: 逐点因果, O(d) 状态, 单资产推进
│   │   │   │   ├── Cpu.hpp                                 # 🧬   挖掘 CPU: 整张量向量化批算, 吞吐 ≥ stream
│   │   │   │   └── Gpu.cuh                                 # 🧬   挖掘 GPU: CUDA, 吞吐 ≥ CPU
│   │   │   ├── CS/                                         # 🧬 截面算子三后端 (同 TS 三份独立实现)
│   │   │   │   ├── Stream.hpp / Cpu.hpp / Gpu.cuh          # 🧬   同上
│   │   │   └── Stat/                                       # 🧬 因子评估算子 (无流式后端): 因子 + 标签 → Row[H][T] (IC / 分组 / 多空) → HoldStat; 并列均秩 + 整数 Pearson, cpu↔gpu 逐位一致
│   │   │       ├── Contract.hpp                            # 🧬   语义契约: Row / HoldStat + 可合并累加器 + 换手成本 (Cost / CostAcc / cost_cell / net_ls: 顶底腿只有新进者付冲击; Run / Inspect 净线同一份, Search 不看)
│   │   │       ├── Check.hpp                               # 🧬   对拍公共件
│   │   │       ├── Cpu.hpp                                 # 🧬   CPU 后端: 行区间核 + 流程
│   │   │       └── Gpu.cuh                                 # 🧬   GPU 后端: 一行一 block
│   │   │   └── Search/                                     # 🧬 参数搜索评估 (建在 Stat 上): 一批同形候选直接攒累加器, 不落 Row
│   │   │       ├── Contract.hpp                            # 🧬   语义契约: 分块流式 + 目标 (固定 h 的 毛 LS · util · rIC, 任一 ≤ 0 → −∞; util = 一腿均成员 / 满仓只数, 唯一活跃度项; 不看成本, 不跨 h 比)
│   │   │       ├── Grid.hpp                                # 🧬   参数网格 (纯逻辑): 可搜槽 → 单调坐标 (阈值按输入 σ 定尺度) → 粗网格 / 细化 / 分支挑选
│   │   │       ├── Cpu.hpp                                 # 🧬   CPU 后端: 复用 Stat 行核 (row_stat / cost_row), 只加块语义与累加
│   │   │       ├── Gpu.cuh                                 # 🧬   GPU 后端: 一 warp 一候选
│   │   │       └── Check.hpp                               # 🧬   对拍公共件 (参考 = Stat CPU)
│   │   ├── math/                                           # 📐 distribution / normalize / sample / spectral / stationary / timeseries / autoencoder / model
│   │   │   ├── Operator.hpp                                # 📐 算子元数据 / 定义 (ParamMeta / OperatorDef, 编译期注册)
│   │   │   ├── stationary/TodProfile.hpp                   # 📐 日内轮廓去季节 (TodSub / TodZ, expanding 因果)
│   │   │   └── spectral/IIRBandpass.hpp                    # 📐 因果 IIR 带通
│   │   ├── api/                                            # 🌐 数据源 API (只管传输 + 单窗口 fetch)
│   │   │   ├── bigquant/                                   # 🌐 BigQuant (dai / fetch / audit)
│   │   │   └── tushare/                                    # 🌐 Tushare (http / parse / fetch)
│   │   ├── fundamental/                                    # 📊 日频基本面数据集 (两数据源同一套)
│   │   │   ├── Spec.hpp                                    # 📊   SPECS: Shape × Pick × src (Dai / Tu)
│   │   │   ├── Store.hpp                                   # 📊   Catalog (一次目录遍历) + 分片状态 + 拉取计划
│   │   │   ├── Sync.hpp                                    # 📊   写侧 pending / sync<Src>: plan → fetch → put
│   │   │   └── Scan.hpp                                    # 📊   读侧分段并行 map-reduce (AssetInfo / fund::Pool 共用)
│   │   ├── mining/                                         # ⛏️ 数据挖掘 (特征 → 因子) 设计文档
│   │   └── misc/                                           # 🔧 通用工具库
│   │       ├── logging.hpp / print.hpp                     # 🔧 日志 / STL 容器格式化打印
│   │       ├── format.hpp                                  # 🔧 定宽数值格式化 (UI 表格 / 日志对齐)
│   │       ├── timer.hpp / profiler.hpp                    # 🔧 计时器 / 性能剖析
│   │       ├── progress_single.hpp / progress_parallel.hpp # 🔧 单行 / 多线程进度条
│   │       ├── affinity.hpp                                # 🔧 CPU 亲和性
│   │       ├── archive.hpp / parquet.hpp                   # 🔧 归档操作 / Parquet 读写
│   │       ├── fs.hpp / file_check.hpp                     # 🔧 文件系统 / 归档完整性校验
│   │       ├── date.hpp / cross_platform.hpp               # 🔧 Ymd / Ym (int32) 日历运算 / Win-Linux-Mac 兼容层
│   │       ├── system_metrics.hpp                          # 🔧 系统监控采集 (CPU / 内存 / 磁盘)
│   │       └── VariableMonitor.hpp                         # 🔧 变量值监控
│   ├── src/                                                # 💾 源文件实现 (对应 include/)
│   │   ├── main.cpp                                        # 💾 程序入口
│   │   ├── factor/op_check.cpp                             # 💾 三后端对拍 CLI (独立 target)
│   │   ├── factor/op_check_gpu.cu                          # 💾 GPU 后端 CUDA 实现 (FACTOR_CUDA ON 时入链)
│   │   ├── factor/op_check_gpu_stub.cpp                    # 💾 GPU stub (未开 CUDA)
│   │   ├── api/ fund/ codec/ shared/ misc/ worker/ feat/   # 💾 对应模块实现
│   │   ├── gui/Gui.cpp / Tasks.cpp                         # 💾 GUI 主循环 / 任务注册
│   │   ├── gui/Run_OpenGL.cpp                              # 💾 OpenGL 后端入口
│   │   └── gui/Run_Vulkan.cpp                              # 💾 Vulkan 后端入口
│   ├── package/                                            # 📚 第三方库 (源码内置, header-only 直接 include)
│   │   ├── boost/                                          # 📚 asio / beast / optional
│   │   ├── nlohmann/ yyjson/ utfcpp/                       # 📚 JSON / 文本编解码
│   │   ├── zlib-1.3.1/ zstd-1.5.7/ arrow/                  # 📚 压缩 / Parquet 列式存储
│   │   ├── imgui/ implot/ glfw/                            # 📚 GUI 渲染
│   │   ├── microtex/ tinyxml2/                             # 📚 LaTeX 渲染 / XML 解析
│   │   └── tracy/                                          # 📚 性能剖析
│   ├── fonts/                                              # 🔤 GUI 字体
│   ├── script/                                             # 🐍 绘图脚本 (bookmap / plot_bars / plot_signals)
│   └── projects/main/                                      # 🏗️ 构建系统
│       ├── CMakeLists.txt                                  # 🏗️ CMake (C++23, Clang)
│       └── build/bin/app_main                              # 🎯 可执行文件
└── output/                                                 # 📁 运行时输出 (与 cpp/ 同级)
    ├── orders/                                             # L2 编码 .bin (逐笔委托 + 成交合并)
    │   └── YYYY/MM/DD/<CODE>.<EX>.bin                      # 单资产单日一个 .bin; 同目录 .stat = 当天账目
    ├── features/                                           # 特征张量库 (Float16, 按交易日全市场, 逐特征列)
    │   └── YYYY/MM/DD/
    │       ├── features_L0_f<f>.zst                        # L0 逐特征列 [T×A] (秒频)
    │       └── features_L1_f<f>.zst                        # L1 逐特征列 [T×A] (分钟频, XOR 差分)
    ├── fundamental/                                        # 日频基本面 (表清单见 DataBase → Overview)
    │   ├── YYYY-MM/<表>.parquet                            # 月度分片 (每表一文件; 0 行月也落文件 = 拉过)
    │   ├── _meta/<表>.parquet                              # Static / Snapshot 单文件整刷
    │   └── asset_axis.json                                 # A 轴 (资产轴) 码表, 只增不删
    ├── doc/                                                # 文档 / 资料 (resources-* 符号链接指向仓库外 ../doc)
    │   ├── checked.md                                      # 研报因子库勾选清单
    │   ├── resources-raw -> ../../../doc/resources-raw     # 原始资料 (公众号 / paper / report / web)
    │   ├── resources-proc -> ../../../doc/resources-proc   # 加工后 (.stat 重算 + markdown 转换)
    │   └── resources-tag -> ../../../doc/resources-tag     # 标注后 (标签体系 + 统计, 给 agent)
    ├── factors/                                            # 因子算子库 (factor/ 的落地)
    │   ├── operators.json                                  # 算子表快照 (对拍 + 耗时), 与当前 OpTable 不符则重算
    │   └── <universe>/                                     # 因子文件 (一因子一文件, 可手写)
    │       └── *.json                                      # {type, name_cn, expr (模板, 自由参数裸键名), note?, weights?: [{hold, expr (具体)}] (Optimize 整体替换; 改 expr 即清), run?, hold_cols?, acc_cols?, stats?: [stat | null] (与 weights 同序)
    └── log/                                                # 运行日志
```

# ================================================
# 加新特征 Guideline (加特征 = 改 / 新建一个算子文件, 其他地方不动)
# ================================================
#
# 动手前必读 (按序):
#   1. cpp/include/features/FeaturesDefine.hpp   NODE_/FIELDS_ 宏格式 + 公式符号规范 (τ/c/j/i/t/D 索引, P 价格族, O 订单流, ε 容差)
#   2. cpp/include/features/DataDefine.hpp       算子契约 (enum Out / y[] / compute / flush / reset), Trigger 触发域, 输入红线 (只准本资产数据 + 日频 PIT)
#   3. cpp/include/features/Operator/unused/     想要的算子可能已有半成品
#   4. 同类别现有算子 1-2 个作模板 (命名 / 公式 / 注释风格照抄):
#        累计降频型 → Operator/TS/OrderFlow/Flow.hpp    盘口时间加权 → Operator/TS/Book/Book.hpp
#        分钟采样型 → Operator/TS/Basic/Bar.hpp         日频广播型  → Operator/TS/Fund/Fund.hpp
#
# 加在哪:
#   时序特征  Operator/TS/<类别>/<Op>.hpp   = class (纯数学) + 文件末尾 NODE_<Name> (节点实例) + FIELDS_L1_<Name> (落盘列)
#   截面因子  Operator/CS/<分类>/<源节点>.hpp = 只有 FIELDS_ 行 (方法在 Method/CS.hpp, owner 名 Cs<源节点>)
#   除此以外不改任何文件: CMake 自动扫描 Operator/{TS,CS} → 拓扑排序生成 NodesGenerated.hpp
#
# 规矩:
#   复用上游 (流式计算图), 不重复计算: 盘口取 Depth.*, 逐笔成交 Δln p 取 TakerRet.out(), 涨跌停取 Fund.y[Fund.lim_up/lim_dn],
#     中间价 / 微观价取 MidPrice/MicroPrice.out(); 依赖必须字面写在 NODE_ 行 (CMake 按 "Up." 抽取, 不藏进 helper 宏)
#   命名语法 {measure}_{event}_{side}_{qualifier}: amt/vol/n/qty + taker/maker/cancel + bid/ask + 窗口/档位/阈值
#     (qty = 存量, vol = 流量; 单档用 l5, 前 N 档累计用裸 5; 缩写忌歧义)
#   缺失一律 NaN 不用 0; fast-math TU 不写 isnan, 无定义用位图 / 守卫显式表示
#   只用断言不用错误处理; 失败越早越好
#   改动字段表 = 落盘指纹变化, 旧特征文件读取即断言失败, 需全量重算 (加列也是)
#   收尾: python3 py/app/format_cpp.py 格式化; 编译和运行留给人类
