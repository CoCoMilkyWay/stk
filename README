│   │   │   ├── LobGraph.hpp                            # 🧮 Lob 档计算图 DAG (节点表由 CMake 扫描生成 <Tier>/NodesGenerated.hpp)
│   │   │   ├── BarGraph.hpp                            # 🧮 Bar 档计算图 DAG (与 LobGraph 对仗)
│   │   │   ├── CoreTs.hpp                              # 🧮 单资产时序骨架 (档无关, CRTP): asset-day = begin_day → feed → end_day; 收行级联 for_each_close (细 → 粗); 续算 = snap 读回 resume
│   │   │   ├── CoreLob.hpp                             # 🧮 Lob 档: 逐笔 → 订单簿 → L_sec → 重采样 L_1min + 标签
