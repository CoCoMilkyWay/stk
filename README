│   │   │   ├── Engine.hpp                              # 📈 执行: 逐根链 drive (评分 / 回测 / 买入持有同一条); 仓位层 (波动率定仓) + 五项成本
│   │   │   ├── Tune.hpp                                # 📈 调参: 优化目标 (行情分割质量) + 参数网格 Grid + 岭回归曲面
│   │   │   ├── Metrics.hpp                             # 📈 指标: 收益统计 / 择时捕获 / 在场段; 一本账 Book
│   │   │   └── Trace.hpp                               # 📈 滚动调参全期轨迹: 逐日以此前窗口拟曲面选参 → 拼接 Cuts → 策略 / 买入持有两本账
│   │   ├── math/                                       # 📐 数学工具
│   │   │   ├── Step.hpp                                # 📐 变换步元数据 / 定义 (编译期注册)
│   │   │   ├── sample/                                 # 📐 重采样: 逐笔 / bar1m → 稠密分钟 K (Tick2Min / Bar2Min) → 本层 bar (Min2Bin); run bar
│   │   │   ├── distribution/                           # 📐 分位 / 矩: DailyQuantile · KLLcache · RetMoments · SizeThresholds
│   │   │   ├── normalize/                              # 📐 expanding / rolling 归一: Normalize · RollingZScore
│   │   │   ├── stationary/                             # 📐 平稳化与诊断: ADF · KPSS · FracDiff · IntDiff · MADetrend · TodProfile
│   │   │   ├── spectral/                               # 📐 谱: DayPSD · MultiResPSD · IIRBandpass
│   │   │   ├── timeseries/                             # 📐 ACF / PACF
│   │   │   └── autoencoder/ · model/                   # 📐 仅设计笔记, 无代码
