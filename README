    ├── orders/                                         # Level-2 逐笔编码 (逐笔委托 + 成交合并)
    │   └── YYYY/MM/YYYYMMDD.bin                        # 一天全市场一个文件: 每资产一个 zstd 帧 + 账目 + 尾部目录
    ├── features/                                       # 特征张量库 (Float16); 一库一目录 <pool>/<tier> (tier = bar / lob)
    │   ├── <pool>/<tier>/lib.json                      # 库清单 (档 / A 轴 / 日期轴 / 轴外资产); 无清单 = 未建库
    │   ├── <pool>/<tier>/snapshot.bin                  # 续算快照 (末日各资产时序状态); 库跑完才落
    │   ├── <pool>/<tier>/features.json                 # 特征表预览成品
    │   ├── <pool>/<tier>/node_time.json                # 用时: 时序逐节点 / 截面逐列 (每轮覆盖)
    │   ├── <pool>/<tier>/YYYY/MM/DD/features_L_*.bin   # 日文件, 一层一个 (Lob: L_sec / L_1min; Bar: L_1min / 分钟箱 / L_1day): 头 + 列目录 + 逐列载荷 [T×A]
    │   ├── all/bar/baskets.bin                         # 篮子价格指数账本 (BasketHistory)
    │   └── all/bar/cta/                                # CTA 价格库 (CtaLib): head.bin 键表 + 已合成日 + 因子链 / stock.bin [D][A] / basket.bin [D][B]
    ├── fundamental/                                    # 日频基本面
    │   ├── YYYY-MM/<表>.parquet                        # 月度分片 (每表一文件; 0 行月也落文件 = 拉过)
    │   ├── YYYY-MM/bar1m/YYYY-MM-DD.parquet            # 分钟 K 日分片 (Bar 档 TS 输入, 不复权)
    │   ├── _meta/<表>.parquet                          # Static / Snapshot 单文件整刷
    │   ├── _audit/<表>.tsv                             # 核对账本 (每月留最近一次, 分片重写即作废)
    │   └── asset_axis.json                             # A 轴 (资产轴) 码表, 只增不删
    ├── concept/YYYYMMDD.tsv                            # 东财概念快照: 一行一概念 = 板块代码 \t 名称 \t 成分码
    ├── sina/live.bin                                   # 新浪当日分钟 K 缓存 (只存行情日一天)
    ├── doc/                                            # 研报资料 (符号链接到仓库外): resources-raw 原始 / resources-proc 加工 / resources-tag 标注 (agent 研报工具的索引)
    ├── factors/                                        # 因子库 (factor/ 的落地)
    │   ├── operators.json                              # 算子表快照 (对拍 + 耗时), 与当前 OpTable 不符则重算
    │   └── <pool>/<层>/                                # 因子文件 (一因子一文件, 可手写); <层> = min / 5min / 15min / 30min / 60min / day
    │       ├── log/<name>.log                          # Search 过程日志 (每次覆盖)
    │       └── *.json                                  # 因子文件字段:
    │                                                   #    · 必填: type / name_cn / expr (模板, 自由参数用裸键名)
    │                                                   #    · 可选: note / run / hold_cols / acc_cols
    │                                                   #    · weights: [{hold, sign?, expr (具体)}]; sign = 所评方向; Search 整体替换, 改 expr 即清空
    │                                                   #    · search: [{hold, start_date, end_date, days, top?}]; Search 结局, 改 expr 即清空
    │                                                   #    · stats: [stat | null], 与 weights 同序
    ├── portfolio/<name>.json                           # 因子组合: {"factors": [{pool, level, file, expr, hold, sign}]}, 条目 = 因子文件里的一个权重
    ├── export/<pool>/<层>/                             # Inspect 导出: <因子>_w<权重号>_top<N>_{log,snap}.csv
    ├── agent/<pool>/<层>/<持有期>/                     # Agent 挖掘会话 (池 × 因子层 × 持有期)
    │   ├── factors/*.json                              # 候选因子文件 (与正式因子同格式); 提交且达门槛的拷进 factors/<pool>/<层>/
    │   └── chat/<YYYYMMDD-HHMMSS>/                     # 一段会话: system.md + 逐轮 md + events.jsonl + report.md
    ├── agent/global/                                   # Agent 不随作用域的东西
    │   ├── {feature,tool,insight,issue}.jsonl          # 全局记录, 一类一个文件
    │   ├── tools/<工具名>.md                           # 各工具最近一次交给 agent 的结果
    │   └── test/                                       # 自检会话 (同会话目录结构 + 自检的全局记录); 不拷进正式库
    ├── profile/<pool>/<YYYYMMDD_HHMMSS>/               # 特征计算 perf 采样 (PROFILE 模式, 每轮一目录): meta.json / threads.txt / 各段热点 / perf.data
    └── log/                                            # 运行日志
```

# ================================================
# 加新特征 Guideline (加特征 = 改 / 新建一个节点文件, 其他地方不动)
# ================================================
#
# 动手前必读 (按序):
#   1. cpp/include/features/FeaturesDefine.hpp   NODE_ / FIELDS_ 宏格式 + 公式符号规范 (索引 τ/c/j/i/t/D; P 价格族; O 订单流; ε 容差)
#   2. cpp/include/features/DataDefine.hpp       节点契约 (enum Out / y[] / compute / flush / reset / carry / kHist / snap) + 输出口 (Port / History) + Trigger 触发域 + 输入红线 (只准本资产数据 + 日频 PIT)
#   3. cpp/include/features/Node/unused/         想要的节点可能已有半成品
#   4. 同类现有节点 1-2 个作模板 (命名 / 公式 / 注释风格照抄):
#        - 累计降频型:   Node/Lob/TS/OrderFlow/Flow.hpp
#        - 盘口时间加权: Node/Lob/TS/Book/Book.hpp
#        - 分钟采样型:   Node/Common/Basic/Kline.hpp + Node/{Lob,Bar}/TS/Basic/Kline.hpp
#        - 回看型:       同域 = 消费方自持窗口 (Node/Bar/TS/Basic/Momentum.hpp); 跨域 = 上游声明 kHist, 下游接 Up.hist() (见 DataDefine.hpp)
#        - 日频型:       Node/Common/Fund/Fund.hpp + Node/Bar/TS/Fund/Fund.hpp (onSettle; 输出口跨天保留, 盘中读到的 = 当日适用值)
#                        (Lob 档的 Fund 节点只供盘中节点取前收 / 涨跌停, 不落盘)
#                        全市场截面 / 长窗的日频量 (市场收益 → ivol / β, 趋势回归, 12−1 动量) 在 fund::Panel 预计算 (Method/Fundamental.cpp build_market), 经 Fund 口进 TS
#        - 截面列:       Node/Bar/CS/Fund/Valuation.hpp
#        - 池列:         Node/Bar/CS/Pool/Pool.hpp
#
# 加在哪 (先定档: 要逐笔 / 盘口 → Lob; 只要分钟 K + 基本面 → Bar):
#   - 时序列:   Node/<Tier>/TS/<分类>/<Name>.hpp
#       · 内容: 节点类 (纯数学) + 文件末尾 NODE_<Name> (节点) + FIELDS_<LVL>_<Name> (落盘列, LVL = L_sec / L_1min / L_5min / L_15min / L_30min / L_60min / L_1day; 本身日频的列放 L_1day)
#       · 触发域: 降频型 onTick + onMinute; 分钟箱型 on<n>Min; 日型 onClose (读 day_data 整日 K); 盘后型 onSettle (日频 PIT 推进到次日)
#       · 行末源标: TS(<节点>[, <口>], Tf, Method)
#   - 截面列:   Node/<Tier>/CS/<分类>/<源节点>.hpp
#       · 内容: 只有 FIELDS_ 行; owner 名 Cs<源节点>; 方法在 Method/CS.hpp
#       · 行末源标: CS(<源档>, <层>, <源列>, Tf, Method); <层> 任意: 源行 = level_asof(源列, 本列, t)
#         (粗层读已收的上一行; 落到前一交易日只许 TS / 元列, 区间首日 NaN)
#   - 两档都要: 节点类放 Node/Common/<分类>/, 两档各写各的 NODE_ / FIELDS_ (列名跨档不许重名, FeatureMeta.cpp 编译期断言)
#   - 新池:   Node/Bar/CS/Pool/Pool.hpp 加一列 pool_<pool> = 多一个子池 <pool> (两档各一库)
#       · 键不够就在 Node/Bar/TS/Pool/PoolKey.hpp 加
#   - 其他文件一律不改: CMake 按档扫描生成 <Tier>/NodesGenerated.hpp + FieldsGenerated.hpp
#
# 规矩:
#   - 复用: 只依赖同档上游节点, 不重复计算
#       · 盘口 → Depth.*; 逐笔成交 Δln p → TakerRet.out(); 涨跌停 → Fund.out(Fund.lim_up / lim_dn); 中间价 / 微观价 → MidPrice / MicroPrice.out()
#       · 依赖必须字面写在 NODE_ 行 (CMake 按 "Up." 抽取, 不许藏进 helper 宏)
#   - 命名: {measure}_{event}_{side}_{qualifier}
#       · measure = amt / vol / n / qty (qty = 存量, vol = 流量); event = taker / maker / cancel; side = bid / ask; qualifier = 窗口 / 价位 / 阈值
#       · 单价位用 l5, 前 N 价位累计用裸 5; 缩写忌歧义
#   - 缺失: 一律 NaN, 不用 0; fast-math TU 不写 isnan, 无定义用位图 / 守卫显式表示
#       · 例外: CS 列在截面 (cs_valid) 外的资产落 0, 读端由 cs_valid 门控, 不当值读
#   - 出错: 只用断言, 不做错误处理; 失败越早越好
#   - 跨天状态: reset 不清的成员一律列进 snap (续算 ≡ 全量); 状态只许依赖库首日, 不许依赖本轮首日
#   - 重算: 改字段表 (含加列) = 落盘指纹变化, 旧特征文件读取即断言失败, 需全量重算
#       · 列名不变但口径变: 标签 kLabelSemver / L_1day 行 kDaySemver +1 (FeatureStoreConfig.hpp), 同样判废
#       · 改节点跨天状态 (snap 成员清单 / 含义): kSnapSemver +1 (FeatureSnap.hpp), 旧快照不可续, 只能全量
