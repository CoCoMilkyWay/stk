```
入口: run.py ──► py/main.py ──► CMake ──► app_main (C++可执行文件)
```

```
stk/
├── run.py                 # 🚀 主入口 → py/main.py (模式选择: TSAN/DEBUG/PROFILE/ASSERT/PRODUCTION)
├── config/                # ⚙️ 全局配置
│   ├── config.json        # ⚙️ 路径/日期范围/universe/基本面联网同步(network_sync) 等全局配置
│   ├── data_manager.json / stock_*.json  # ⚙️ 运行时缓存状态 (自动生成)
│   ├── universe/          # ⚙️ 股票池定义 (smallcap400.json 等, 供 config.json 引用)
│   └── sample/            # ⚙️ 样例数据 (L1/L2/财务报表样例)
├── py/                    # 🐍 Python工具链
│   ├── main.py            # 🐍 构建脚本: 直接调用 CMake
│   ├── mode_*.py          # 🐍 模式开关: tsan/debug/profile/assert/production
│   └── app/               # 🐍 build_universe (股票池) / FileRepair / pdf2txt / format_cpp (clang-format) / lint_cpp (clangd 诊断)
├── cpp/
│   ├── include/
│   │   ├── shared/                                   # 📦 跨模块数据层
│   │   │   ├── SharedData.hpp                        # 📦 顶层数据容器 (全局状态)
│   │   │   ├── Config.hpp                            # 📦 配置数据结构
│   │   │   ├── TaskState.hpp                         # 📦 任务状态
│   │   │   ├── Asset.hpp / AssetInfo.hpp             # 📦 资产定义与元数据
│   │   │   ├── AssetAxis.hpp                         # 📦 A轴(资产轴)对齐
│   │   │   ├── Feature.hpp                           # 📦 特征元数据 + 选择 (多选 selected_features, 首个=主特征)
│   │   │   ├── OrderFlow.hpp                         # 📦 订单流数据
│   │   │   ├── Analysis.hpp                          # 📦 流式分析公共骨架: StreamState (进度/epoch/锁) / Integrity / PdfSnap (KLL 成品) / ReadScope / 常量
│   │   │   ├── Dist.hpp                              # 📦 分布分析 (KLL, 分批流式, DayBatchPlane, 月/周/日内/资产四维)
│   │   │   ├── Transform.hpp                         # 📦 特征变换探索 (分批流式): season→stationary→IIR带通→ts_norm→CS, 与生产算子同一套; 全资产逐天 ADF/KPSS/PSD/ACF
│   │   │   ├── FeaturePreview.hpp                    # 📦 特征表内联预览 (轮训抽样): 每特征 PDF + 单日 PSD 均值
│   │   │   └── EncodeDayRecord.hpp                   # 📦 单日编码统计 (.stat): 定宽头 [齐备/资产数/错误原因] + 定长明细 [(A轴下标, 条数, 体积), 皆0=墓碑], 扫描免逐个 .bin 读头
│   │   ├── define/                                   # 🔷 底层数据结构
│   │   │   ├── CBuffer.hpp                           # 🔷 循环缓冲区
│   │   │   ├── FastBitmap.hpp                        # 🔷 快速位图
│   │   │   └── MemPool.hpp                           # 🔷 内存池
│   │   ├── lob/                                      # 📊 限价订单簿引擎 (LOB)
│   │   │   ├── LimitOrderBook.hpp                    # 📊 LOB主引擎: 维护买卖盘+撮合逻辑
│   │   │   └── LimitOrderBookDefine.hpp              # 📊 订单/价格档位数据结构
│   │   ├── codec/                                    # 🔄 L2数据编解码
│   │   │   ├── L2_DataType.hpp                       # 🔄 L2数据类型: 快照/逐笔成交/逐笔委托
│   │   │   ├── L2_Gateway_DataType.hpp               # 🔄 L2网关数据类型
│   │   │   ├── binary_decoder_L2.hpp                 # 🔄 二进制解码: .bin -> L2对象
│   │   │   ├── binary_encoder_L2.hpp                 # 🔄 二进制编码: L2对象 -> .bin
│   │   │   ├── L2_Validator.hpp                      # 🔄 逐笔数据准入校验 (编码期判完整性, 防缺片污染盘口)
│   │   │   └── json_config.hpp                       # 🔄 JSON配置解析
│   │   ├── features/                                 # 🧮 特征工程 (多时间尺度)
│   │   │   ├── FeaturesDefine.hpp                    # 🧮 字段表格式说明 (NODE_/FIELDS_ 9列) + 元数据枚举 (X-macro) + SRC 列解析 + ALL_LEVELS (L0/L1 两层)
│   │   │   ├── TimeIndex.hpp                         # 🧮 时间索引: Clock ↔ L0(秒) ↔ L1(分钟), 交易时段常数
│   │   │   ├── DataDefine.hpp                        # 🧮 TickData/MinuteData, Trigger 触发域, Series/DepthSeries 别名, 算子契约
│   │   │   ├── ComputeGraph.hpp                      # 🧮 计算图: Node<Op,K> 输出 Series + DAG (CMake 拓扑序生成 NodesGenerated.hpp, NODE_ 变参 flush 默认=compute)
│   │   │   ├── CoreSequential.hpp                    # 🧮 单资产时序: tick→DAG→写 L0, 分钟边界→重采样→写 L1; 标签回填手工写 (ts_write_range<LVL>)
│   │   │   ├── CoreCrosssection.hpp                  # 🧮 截面: 字段表 CS(...) 行编译期展开 (CsLevel<LVL>), L0 每秒 + L1 分钟级联
│   │   │   ├── MetaFlag.hpp                          # 🧮 _meta 列三态(零/正data/负depth)编码解码稳定头 (消费端不依赖 Meta 算子)
│   │   │   ├── Operator/TS/                          # 🧮 时序算子(数学 class + 文件末尾 NODE_/FIELDS_ 宏)
│   │   │   ├── Operator/CS/                          # 🧮 截面算子(文件末尾 FIELDS_ 宏)
│   │   │   ├── Operator/unused/                      # 🧮 未启用 (TS/ 与 CS/ 两层, 保留半成品) 
│   │   │   ├── Method/                               # 🧮 CS.hpp: Tf(None/Reciprocal/Log)×Method(Rank/NormRank/WinsorRank/NeutralRank/Demean/Z/WinsorZ);
│   │   │   │                                         # 🧮 TS.hpp: Tf(None/Log/Asinh/Tanh/Sqrt)×Method(占位);
│   │   │   │                                         # 🧮 Fundamental.hpp: 日频 PIT 基本面数据源(Pool) + 逐日推进状态机(Stream), Fund 算子共用;
│   │   │   └── Backend/                              # 🧮 特征存储后端
│   │   │       ├── FeatureStoreConfig.hpp            # 🧮 写端: 由字段表 + ALL_LEVELS 展开编译期 LEVELS[] (定址折叠), width/valid/psd 全推导
│   │   │       ├── FeatureLevels.hpp                 # 🧮 读端稳定层 (字段表无关): LevelInfo 结构 + 运行时层表 level_info(), 增删特征不触发读侧重编
│   │   │       ├── FeatureStore.hpp                  # 🧮 存储引擎: [T][F][A] Float16 槽位, TS/CS/IO 三类 worker 并发协议, fstore:: 写入函数 (LEVELS 驱动)
│   │   │       ├── FeatureRead.hpp                   # 🧮 读取引擎: Zstd解压/按列选读 (DayTensor 单日 / MonthTensor 多日常驻块)
│   │   │       ├── DayBatchPlane.hpp                 # 🧮 Dist/Transform 共用天批平面: 抢单天并行载入 → [列][A][批天][VR]
│   │   │       ├── SparseCodec.hpp                   # 🧮 落盘编码之一: 位图+非零字面 (手搓, 内存带宽级, 默认)
│   │   │       └── ZstdCodec.hpp                     # 🧮 落盘编码之二: zstd 熵压缩 (压得狠但单核慢; 同 API, 选型在 FeatureStoreConfig)
│   │   ├── worker/                                   # ⚡ 多线程工作流编排
│   │   │   ├── encoding_worker.hpp                   # ⚡ 编码工作器
│   │   │   └── feature_workers.hpp                   # ⚡ 特征计算四角色 (预取/时序/截面/落盘): 统一签名 WorkerCtx + TS 调度面 TsSchedule
│   │   ├── label/                                    # 🏷️ 标签生成
│   │   │   └── LabelCalmar.hpp                       # 🏷️ Calmar比率标签
│   │   ├── gui/                                      # 🖥️ GUI (ImGui + 协程)
│   │   │   ├── Gui.hpp                               # 🖥️ GUI主循环: ImGui渲染 + 事件分发
│   │   │   ├── Config.hpp                            # 🖥️ GUI配置: 颜色/字体/布局
│   │   │   ├── Tasks.hpp                             # 🖥️ 任务树: 左栏选中/状态标签/生命周期 (idx==-1 任务行, idx>=0 子行)
│   │   │   ├── util/Color.hpp / AssetFilter.hpp      # 🖥️ 颜色 / 资产过滤
│   │   │   ├── coro/                                 # 🖥️ 协程基础设施
│   │   │   │   └── CoroManager.hpp                   # 🖥️ 协程管理器: 调度/生命周期
│   │   │   ├── task_settings/                        # 🖥️
│   │   │   │   └── TaskSettings.hpp                  # 🖥️ 设置: 配置管理 [synced/syncing/writing]
│   │   │   ├── task_system_info/                     # 🖥️
│   │   │   │   └── TaskSystemInfo.hpp                # 🖥️ 系统信息: CPU/内存/磁盘监控 [/live]
│   │   │   ├── task_icon_bar/                        # 🖥️
│   │   │   │   ├── TaskIconBar.hpp                   # 🖥️ 图标栏: 网络状态/FPS
│   │   │   │   └── CoroNetwork.hpp                   # 🖥️ 网络子协程: 异步请求
│   │   │   ├── task_tools/                           # 🖥️
│   │   │   │   ├── TaskTools.hpp                     # 🖥️ 工具任务主界面
│   │   │   │   └── ui/TabLatex.hpp                   # 🖥️ LaTeX 渲染标签页
│   │   │   ├── task_database/                        # 🖥️ 数据库管理
│   │   │   │   ├── TaskDatabase.hpp                  # 🖥️ 数据库任务主界面
│   │   │   │   ├── models/SharedTypes.hpp            # 🖥️ 数据模型
│   │   │   │   ├── services/                         # 🖥️ 业务服务层 (Asset/Encoding/Fundamental/L2Database/Scan/Classifier/StateManager)
│   │   │   │   ├── infrastructure/ScanThreadPool.hpp # 🖥️ 扫描线程池
│   │   │   │   └── ui/                               # 🖥️ UI (TabOverview 基本面同步 ↓ /TabBrowser/TabTable/TabEncode/CrossSectionAnalysis)
│   │   │   ├── task_features/                        # 🖥️ 特征计算管理
│   │   │   │   ├── TaskFeatures.hpp                  # 🖥️ 特征任务主界面
│   │   │   │   ├── services/                         # 🖥️ 特征服务层
│   │   │   │   │   ├── ComputeService.hpp            # 🖥️ 计算服务
│   │   │   │   │   ├── StreamService.hpp             # 🖥️ 流式分析单 worker 编排骨架 (CRTP): Request 覆盖/取消/Start/Stop/Shutdown
│   │   │   │   │   ├── DistService.hpp               # 🖥️ 分布分析服务 (StreamService)
│   │   │   │   │   ├── TransformService.hpp          # 🖥️ 特征变换服务 (StreamService)
│   │   │   │   │   ├── PreviewService.hpp            # 🖥️ 特征表预览服务 (StreamService)
│   │   │   │   │   ├── OrderFlowService.hpp          # 🖥️ 订单流服务
│   │   │   │   │   └── CorrService.hpp               # 🖥️ 相关矩阵 / lead-lag 服务 (StreamService): 矩阵 + 单对 + lag 矩阵三独立 service
│   │   │   │   └── ui/                               # 🖥️ UI组件
│   │   │   │       ├── Common.hpp                    # 🖥️ 流式 tab 公共件: 状态行 (Compute/Cancel/进度) / 账目着色 / 高亮线
│   │   │   │       ├── TabFeature.hpp                # 🖥️ 特征表: 过滤 + 多选 (首个=主特征)
│   │   │   │       ├── TabCompute.hpp                # 🖥️ 计算标签页
│   │   │   │       ├── TabOrderFlow.hpp              # 🖥️ 订单流标签页
│   │   │   │       ├── TabDist.hpp                   # 🖥️ 分布: 月/周/日内/资产 四维 PDF
│   │   │   │       ├── TabTransform.hpp              # 🖥️ 变换链: 季节→平稳化→带通→TS归一→截面; 诊断: ADF/KPSS 热力条 / PSD / ACF/PACF
│   │   │   │       └── TabCorr.hpp                   # 🖥️ 相关矩阵热图: 下三角 + hover lead-lag 曲线 + lag 矩阵 (聚类排序 O(n³))
│   │   │   └── task_factors/                         # 🖥️ 因子算子库 (factor/ 的 GUI; 合成张量对拍, 不依赖特征库/数据库扫描)
│   │   │       ├── TaskFactors.hpp                   # 🖥️ 因子任务主界面 (单子页 Operators; 进页优先载入 operators.json, 缺/校验不过才自动算一轮, 手动 Run 重算, 跑完落盘)
│   │   │       ├── services/
│   │   │       │   └── OperatorsService.hpp          # 🖥️ 算子表服务: OpTable 全算子一行一算子, worker 三后端对拍+计时 (stream 为 golden; d/k 每算子默认表, seed 取时间戳; gpu 计时 = 纯 kernel)
│   │   │       └── ui/
│   │   │           └── TabOperators.hpp              # 🖥️ 算子表 tab: 静态列 (idx/元数/窗/域/核/参数/公式/Note, 默认按全局 idx 排) + 动态列 (stream/cpu/gpu 耗时与对拍 Δ); operators.json 存/取 (取时逐行校验静态列, 不过即删)
│   │   │   GUI布局:
│   │   │   ┌───────────────────────────────────────────────────────────────────────────┐
│   │   │   │ Tasks                                │ Panel:                             │
│   │   │   │  > Settings[synced/syncing/writing]  │                                    │
│   │   │   │  > SystemInfo[""/live]               │                                    │
│   │   │   │  > DataBase                          │ Overview / Encode / Table / Browser│
│   │   │   │  > Features                          │ Feature / Compute / Transform /    │
│   │   │   │                                      │ Dist / Corr / OrderFlow            │
│   │   │   │  > Factors                           │ Operators                          │
│   │   │   │  > Tools                             │ LaTeX                              │
│   │   │   │ Icon:                                │                                    │
│   │   │   │  |Network|FPS│                       │                                    │
│   │   │   └───────────────────────────────────────────────────────────────────────────┘
│   │   ├── factor/                                         # 🧬 因子算子基建 (特征之上的 TS/CS 算子; 因子 = 特征的非线性算子组合)
│   │   │   ├── Contract.hpp                                # 🧬 语义契约 (三后端唯一共享件之一): 三维分类 T窗(POINT|EXPAND|ROLL|EXPO) × A域(SELF|ALL|GROUP) × 核类(MAP|SHIFT|MOMENT|EXTREME|ORDER|RECUR); SoA 布局 [T][A], branchless 数值, 退化判据
│   │   │   ├── OpTable.hpp                                 # 🧬 真相表 X-macro (另一共享件): 命名 域_核_窗 (TsMeanRoll/TsMeanCum/CsMean); 统一行格式 (元数/T窗/A域/核类/参数/公式), 三后端同名展开; 行序 = 全局 idx (元数→Ts/Cs→窗/域→核→字母), code 与 UI 统一按它; 后端怎么算不进表
│   │   │   ├── StreamHist.hpp                              # 🧬 流式后端专用分桶直方图 (序统计族 rank/quantile, 整数桶计数 → 三后端逐位一致)
│   │   │   ├── Check.hpp                                   # 🧬 对拍公共件: recipe_of / kKParams (阈值) / kDParams·default_d (每算子默认窗长, GUI Operators 表用; op_check 不吃, 全扫 d) / tol_of 容差 / compare 掩码逐位+数值
│   │   │   ├── GpuRun.hpp                                  # 🧬 GPU 对拍宿主接口 (POD 指针; run_ts/run_cs 可选回填纯 kernel 耗时 kernel_ms = cudaEvent, 不含 malloc/H2D/D2H; device_name() 探测 0 号设备型号; 未开 CUDA 链 stub, 退化为两方对拍)
│   │   │   ├── TS/                                         # 🧬 时序算子三后端 (同名 struct, 互不可见, 缺一 → op_check 编译错)
│   │   │   │   ├── Stream.hpp                              # 🧬   实盘流式 (逐点因果, O(d) 状态, 单资产推进)
│   │   │   │   ├── Cpu.hpp                                 # 🧬   挖掘 CPU (整张量向量化批算, 无 GPU 时的 fallback, 吞吐 ≥ stream)
│   │   │   │   └── Gpu.cuh                                 # 🧬   挖掘 GPU (CUDA 向量化, POINT/GATHER/SCAN/EXTREME/HIST/RECUR, 吞吐 ≥ CPU)
│   │   │   └── CS/                                         # 🧬 截面算子三后端 (同名 struct, 同 TS 三份独立实现)
│   │   │       ├── Stream.hpp / Cpu.hpp / Gpu.cuh          # 🧬   GPU 策略: REDUCE / HIST / GROUP
│   │   ├── math/                                           # 📐 distribution / normalize / sample / spectral / stationary / timeseries / autoencoder / model
│   │   │   ├── Operator.hpp                                # 📐 算子元数据/定义 (ParamMeta / OperatorDef, 编译期注册)
│   │   │   ├── stationary/TodProfile.hpp                   # 📐 日内轮廓去季节 (TodSub / TodZ, expanding 因果)
│   │   │   └── spectral/IIRBandpass.hpp                    # 📐 因果 IIR 带通 (无 FIR/零相位)
│   │   ├── api/                                            # 🌐 数据源 API
│   │   │   ├── bigquant/                                   # 🌐 BigQuant (dai/pipeline/spec)
│   │   │   └── tushare/                                    # 🌐 Tushare (http/parse/pipeline/spec)
│   │   ├── mining/                                         # ⛏️ 数据挖掘(特征->因子) 设计文档
│   │   └── misc/                                           # 🔧 通用工具库
│   │       ├── logging.hpp / print.hpp                     # 🔧 日志 / STL容器格式化打印
│   │       ├── format.hpp                                  # 🔧 定宽数值格式化 (UI 表格 / 日志对齐, 精度换宽度)
│   │       ├── timer.hpp / profiler.hpp                    # 🔧 计时器 / 性能剖析
│   │       ├── progress_single.hpp / progress_parallel.hpp # 🔧 单行/多线程进度条
│   │       ├── affinity.hpp / schedule.hpp                 # 🔧 CPU亲和性 / 月度调度器 (bigquant+tushare共用)
│   │       ├── archive.hpp / parquet.hpp                   # 🔧 归档操作 / Parquet读写
│   │       ├── fs.hpp / file_check.hpp                     # 🔧 文件系统 / 归档完整性校验
│   │       ├── date.hpp / cross_platform.hpp               # 🔧 YYYYMMDD日历运算 / Win-Linux-Mac兼容层
│   │       ├── system_metrics.hpp                          # 🔧 系统监控采集 (CPU/内存/磁盘, GUI共用)
│   │       └── VariableMonitor.hpp                         # 🔧 变量值监控
│   ├── src/                                                # 💾 源文件实现 (多数对应include/, boost/math为header-only无实现)
│   │   ├── main.cpp                                        # 💾 程序入口
│   │   ├── factor/op_check.cpp                             # 💾 三方对拍 CLI (独立 target op_check: stream 实盘流式 / cpu 挖掘向量 / gpu 挖掘 CUDA; 造数+边界 profile, 掩码逐位相等+容差)
│   │   ├── factor/op_check_gpu.cu                          # 💾 GPU 后端 CUDA 实现 (nvcc 编译, 仅 FACTOR_CUDA ON 时入链)
│   │   ├── factor/op_check_gpu_stub.cpp                    # 💾 GPU stub (无 CUDA 时 available()=false, op_check 退化为 cpu↔stream 两方对拍)
│   │   ├── api/ codec/ shared/ misc/ worker/ features/     # 💾 对应模块实现
│   │   ├── gui/Gui.cpp / Tasks.cpp                         # 💾 GUI主循环与任务注册实现
│   │   ├── gui/Run_OpenGL.cpp                              # 💾 OpenGL后端入口
│   │   └── gui/Run_Vulkan.cpp                              # 💾 Vulkan后端入口
│   ├── package/                                            # 📚 第三方库 (源码内置, header-only 直接 include)
│   │   ├── boost/                                          # 📚 asio / beast / optional (header-only)
│   │   ├── nlohmann/ yyjson/ utfcpp/                       # 📚 JSON / 文本编解码
│   │   ├── zlib-1.3.1/ zstd-1.5.7/ arrow/                  # 📚 压缩 / Parquet列式存储
│   │   ├── imgui/ implot/ glfw/                            # 📚 GUI渲染
│   │   ├── microtex/ tinyxml2/                             # 📚 LaTeX渲染 / XML解析
│   │   └── tracy/                                          # 📚 性能剖析
│   ├── fonts/                                              # 🔤 GUI字体文件
│   ├── script/                                             # 🐍 绘图脚本 (bookmap/plot_bars/plot_signals)
│   └── projects/main/                                      # 🏗️ 构建系统
│       ├── CMakeLists.txt                                  # 🏗️ CMake配置 (C++23, Clang)
│       └── build/bin/app_main                              # 🎯 最终可执行文件
└── output/                                                 # 📁 运行时输出 (与cpp/同级)
    ├── orders/                                             # L2 编码 .bin (逐笔委托+成交合并)
    │   └── YYYY/MM/DD/<CODE>.<EX>.bin                      # 单资产单日一个 .bin; 同目录 .stat = 当天唯一的元数据 (账目+逐资产计量+墓碑)
    ├── features/                                           # 特征张量库 (Float16, 按交易日全市场列式; L0/L1 皆逐列)
    │   └── YYYY/MM/DD/
    │       ├── features_L0_f<f>.zst                        # L0 逐特征列 [T×A] (秒频, 按列选读)
    │       └── features_L1_f<f>.zst                        # L1 逐特征列 [T×A] (分钟频, XOR 差分 + 按列选读)
    ├── fundamental/                                        # 日频基本面 (表清单见上方 DataBase → Overview)
    │   ├── YYYY-MM/<表>.parquet                            # 月度分片 (2015-01 起, 每表一文件; 0 行月也落文件 = "拉过")
    │   ├── _meta/<表>.parquet                              # Static/Snapshot 单文件整刷 (cn_stock_basic_info / cn_stock_static_data)
    │   └── asset_axis.json                                 # A 轴 (资产轴) 码表, 只增不删
    ├── doc/                                                # 文档/资料 (resources-* 符号链接指向仓库外 ../doc)
    │   ├── checked.md                                      # 研报因子库勾选清单 (按主题分组, 标注因子数)
    │   ├── resources-raw -> ../../../doc/resources-raw     # 原始资料 (gzh 公众号 / paper / report / web)
    │   ├── resources-proc -> ../../../doc/resources-proc   # 加工后 (fix_stat.py 重算 .stat + report/, MinerU转markdown)
    │   └── resources-tag -> ../../../doc/resources-tag     # 标注后(for AI agent) (tag.md 标签体系 + tag_stat.md 统计 + report/)
    ├── factors/                                            # 因子算子库 (factor/ 的落地)
    │   └── operators.json                                  # 算子表全量快照 (一行一算子: 静态列 + stream/cpu/gpu 对拍与耗时), 每轮跑完覆盖; 与 universe/日期无关
    │                                                       #   进页即载入显示 (不重算): 整轮 done + 逐行静态列对上当前 OpTable 才吃, 否则删掉自动重算
    └── log/                                                # 运行日志
```

# ================================================
# 加新特征 Guideline (给 agent: 加特征 = 改/新建一个算子文件, 其他地方不动)
# ================================================
#
# 动手前必读 (按序):
#   1. cpp/include/features/FeaturesDefine.hpp   NODE_/FIELDS_ 宏格式 + 公式符号规范 (τ/c/j/i/t/D 索引, P 价格族, O 订单流, ε 容差)
#   2. cpp/include/features/DataDefine.hpp       算子契约 (enum Out / y[] / compute / flush / reset), Trigger 触发域, 输入红线 (只准本资产数据 + 日频 PIT)
#   3. cpp/include/features/Operator/unused/     先翻一遍: 想要的算子可能已有半成品
#   4. 同类别现有算子 1-2 个作模板 (命名/公式/注释风格照抄):
#        累计降频型 → Operator/TS/OrderFlow/Flow.hpp    盘口时间加权 → Operator/TS/Book/Book.hpp
#        分钟采样型 → Operator/TS/Basic/Bar.hpp         日频广播型  → Operator/TS/Fund/Fund.hpp
#
# 加在哪:
#   时序特征  Operator/TS/<类别>/<Op>.hpp   = class (纯数学) + 文件末尾 NODE_<Name>(节点实例) + FIELDS_L1_<Name>(落盘列)
#   截面因子  Operator/CS/<分类>/<源节点>.hpp = 只有 FIELDS_ 行 (方法在 Method/CS.hpp, owner 名 Cs<源节点>)
#   除此以外不改任何文件: CMake 自动扫描 Operator/{TS,CS} → 拓扑排序生成 NodesGenerated.hpp, 下次 build 自动 configure
#
# 规矩:
#   复用上游(流式计算图), 不重复计算: 盘口取 Depth.*, 逐笔成交 Δln p 取 TakerRet.out(), 涨跌停取 Fund.y[Fund.lim_up/lim_dn],
#     中间价/微观价取 MidPrice/MicroPrice.out(); 依赖必须字面写在 NODE_ 行 (CMake 按 "Up." 抽取, 不要藏进 helper 宏)
#   命名语法 {measure}_{event}_{side}_{qualifier}: amt/vol/n/qty + taker/maker/cancel + bid/ask + 窗口/档位/阈值
#     (qty=存量 vol=流量; 单档用 l5, 前 N 档累计用裸 5; 缩写忌歧义, 反例: fcf 曾被误读 free cash flow → cf_fin)
#   缺失一律 NaN 不用 0; fast-math TU 不写 isnan, 无定义用位图/守卫显式表示
#   只用断言不用错误处理; 失败越早越好
#   改动字段表 = 落盘指纹变化, 旧特征文件读取即断言失败, 需全量重算 (加列也是)
#   收尾: python3 py/app/format_cpp.py 格式化; 编译和运行留给人类
