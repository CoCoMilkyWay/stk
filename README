│   │   │   ├── task_system_info/                        # 🖥️
│   │   │   │   └── TaskSystemInfo.hpp                   # 🖥️ 系统信息: CPU/内存/磁盘监控 [/live]
│   │   │   ├── task_icon_bar/                           # 🖥️
│   │   │   │   ├── TaskIconBar.hpp                      # 🖥️ 图标栏: 网络状态/FPS
│   │   │   │   └── CoroNetwork.hpp                      # 🖥️ 网络子协程: 异步请求
│   │   │   ├── task_tools/                              # 🖥️
│   │   │   │   ├── TaskTools.hpp                        # 🖥️ 工具任务主界面
