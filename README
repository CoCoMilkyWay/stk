│   └── projects/main/                                  # 🏗️ 构建系统
│       ├── CMakeLists.txt                              # 🏗️ CMake (C++23, Clang); 按档扫描 Node/<Tier>/{TS,CS} → 拓扑排序 → 生成节点表 / 字段表
│       ├── templates/                                  # 🏗️ 生成头模板: NodesGenerated / FieldsGenerated / FeatureCategoriesGenerated
