│   │   │   │   ├── services/                            # 🖥️ 业务服务层 (Asset/Encoding/Fundamental/L2Database/Scan/Classifier/StateManager)
│   │   │   │   ├── infrastructure/ScanThreadPool.hpp    # 🖥️ 扫描线程池
│   │   │   │   └── ui/                                  # 🖥️ UI (TabOverview 基本面同步 ↓ /TabBrowser/TabTable/TabEncode/CrossSectionAnalysis)
│   │   │   └── task_features/                           # 🖥️ 特征计算管理
│   │   │       ├── TaskFeatures.hpp                     # 🖥️ 特征任务主界面
│   │   │       ├── services/                            # 🖥️ 特征服务层
