│   │   │   │       ├── TabDist.hpp                   # 🖥️ 分布 PDF
│   │   │   │       ├── TabTransform.hpp              # 🖥️ 变换链 + 平稳性诊断
│   │   │   │       └── TabCorr.hpp                   # 🖥️ 相关矩阵热图 + lead-lag
│   │   │   └── task_factors/                         # 🖥️ 因子库 (factor/ 的 GUI): Operators 算子对拍 (合成张量, 不依赖特征库) / Factors 因子面板 / Inspect 单因子深看
│   │   │       ├── TaskFactors.hpp                   # 🖥️ 因子任务主界面 (三子页)
│   │   │       ├── services/
│   │   │       │   ├── OperatorsService.hpp          # 🖥️ 算子表: 三后端对拍 + 计时 (stream 为 golden)
│   │   │       │   ├── FactorsService.hpp            # 🖥️ 因子面板: 扫因子文件 (expr 模板 + weights 一权重一行) → 合成共享 DAG 评估 (毛 HoldStat + 每档换手成本 CostAcc) → 只回写 weights[i].stat (expr 不动, 破碎标 BROKEN 不删); 看板 score / util 由 stat 现算
│   │   │       │   ├── FactorsLoad.hpp               # 🖥️ 装载层 (三服务共用): 特征 / 门控 / 标签 / 成本 宿主平面; n_full_of 满仓只数; cost_tiers 换手成本 (Run / Inspect 同一份)
│   │   │       │   ├── InspectService.hpp            # 🖥️ 单因子深看: 多级缓存, 从失效级起算; 不写文件; 期限结构净线的换手成本 (Stat cost_row, 与 Run 同一份)
│   │   │       │   └── SearchService.hpp             # 🖥️ 参数搜索 (Optimize, 单 worker): 模板自由参数粗网格 → 每局部峰一支逐层细化; 搜索窗 30m~T+1 每 h 各搜 (标签一次装全, 因子平面只算一遍), 目标 = 毛 LS · 资金利用率 · rIC (不看成本, 不跨 h 比); 高原集按截面相关挑 ≤3 → 整体替换 weights
│   │   │       └── ui/
│   │   │           ├── TabOperators.hpp              # 🖥️ 算子表 tab
│   │   │           ├── TabFactors.hpp                # 🖥️ 因子面板 tab: 构建器 + 因子表
│   │   │           ├── TabInspect.hpp                # 🖥️ 单因子深看 tab: 控件只切结果立方体, 不发请求
│   │   │           └── StatJson.hpp                  # 🖥️ HoldStat ↔ JSON
│   │   │   GUI布局:
│   │   │   ┌───────────────────────────────────────────────────────────────────────────┐
│   │   │   │ Tasks                                │ Panel:                             │
