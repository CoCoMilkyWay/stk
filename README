```
入口: run.py ──► py/main.py ──► CMake ──► app_main (C++可执行文件)
```

```
stk/
├── run.py                 # 🚀 主入口 → py/main.py (模式: TSAN/DEBUG/PROFILE/ASSERT/PRODUCTION; ENABLE_CUDA 正交开关 = factor GPU 后端 nvcc 链/stub)
├── config/                # ⚙️ 全局配置
│   ├── config.json        # ⚙️ 路径 / 日期区间 / universe / 基本面联网同步 / 税佣 / 平仓冲击 sell_impact
│   ├── data_manager.json / stock_*.json  # ⚙️ 运行时缓存状态 (自动生成)
│   ├── universe/          # ⚙️ 股票池定义 (py/universe 产出, config.json 引用)
│   └── sample/            # ⚙️ 样例数据 (L1 / L2 / 财务报表)
├── py/                    # 🐍 Python 工具链
│   ├── main.py            # 🐍 构建脚本 (调 CMake)
│   ├── mode_*.py          # 🐍 模式开关: tsan / debug / profile / assert / production
│   ├── app/               # 🐍 FileRepair / pdf2txt / format_cpp (clang-format) / lint_cpp (clangd 诊断)
│   └── universe/          # 🐍 股票池生成: 一池一脚本 → config/universe/<name>.json
│       ├── common/        # 🐍 共用骨架: data (基本面 parquet 读取) / grid (PIT 网格) / filters (退市风险排除) / pipeline (骨架 + JSON 接口)
│       └── smallcap400.py # 🐍 小市值 400 动态池
├── cpp/
│   ├── include/
│   │   ├── shared/                                   # 📦 跨模块数据层 (GUI 任务与 worker 共享的状态)
│   │   │   ├── SharedData.hpp                        # 📦 顶层数据容器
│   │   │   ├── Config.hpp                            # 📦 配置数据结构
│   │   │   ├── TaskState.hpp                         # 📦 任务状态
│   │   │   ├── Asset.hpp / AssetInfo.hpp             # 📦 资产定义 / 元数据
│   │   │   ├── AssetAxis.hpp                         # 📦 A 轴 (资产轴) 对齐
│   │   │   ├── Universe.hpp                          # 📦 动态股票池 (日频 PIT 名单, JSON diff 回放) → cs_valid 门控 + 静态 A 轴; 只读 py/universe 产出
│   │   │   ├── Feature.hpp                           # 📦 特征元数据 + 多选 (首个 = 主特征)
│   │   │   ├── OrderFlow.hpp                         # 📦 订单流数据
│   │   │   ├── Analysis.hpp                          # 📦 流式分析公共骨架: StreamState (进度 / epoch / 锁) / Integrity / PdfSnap (KLL 成品) / ReadScope
│   │   │   ├── Dist.hpp                              # 📦 分布分析: KLL 分批流式, 月 / 周 / 日内 / 资产四维
│   │   │   ├── Correlation.hpp                       # 📦 相关分析: 特征两两截面 Spearman 矩阵 (逐抽样日流式) + lead-lag 单对 / lag 矩阵
│   │   │   ├── Transform.hpp                         # 📦 变换探索: season → stationary → IIR 带通 → ts_norm → CS, 与生产算子同一套; 逐天 ADF / KPSS / PSD / ACF
│   │   │   ├── FeaturePreview.hpp                    # 📦 特征表内联预览: 每特征 PDF + 单日 PSD
│   │   │   └── EncodeDayRecord.hpp                   # 📦 单日编码账目 (.stat): 定宽头 + 逐资产定长明细, 扫描免逐个 .bin 读头
│   │   ├── define/                                   # 🔷 底层数据结构
│   │   │   ├── CBuffer.hpp                           # 🔷 循环缓冲区
│   │   │   ├── FastBitmap.hpp                        # 🔷 位图
│   │   │   └── MemPool.hpp                           # 🔷 内存池
│   │   ├── lob/                                      # 📊 限价订单簿引擎
│   │   │   ├── LimitOrderBook.hpp                    # 📊 买卖盘维护 + 撮合
│   │   │   └── LimitOrderBookDefine.hpp              # 📊 订单 / 价格档位结构
│   │   ├── codec/                                    # 🔄 L2 编解码
│   │   │   ├── L2_DataType.hpp                       # 🔄 L2 数据类型: 快照 / 逐笔成交 / 逐笔委托
│   │   │   ├── L2_Gateway_DataType.hpp               # 🔄 L2 网关数据类型
│   │   │   ├── binary_decoder_L2.hpp                 # 🔄 .bin → L2 对象
│   │   │   ├── binary_encoder_L2.hpp                 # 🔄 L2 对象 → .bin
│   │   │   ├── L2_Validator.hpp                      # 🔄 逐笔数据准入校验: 编码期判完整性, 防缺片污染盘口
│   │   │   └── json_config.hpp                       # 🔄 JSON 配置解析
│   │   ├── features/                                 # 🧮 特征工程 (两层时间尺度: L0 秒 / L1 分钟)
│   │   │   ├── FeaturesDefine.hpp                    # 🧮 字段表格式 (NODE_ / FIELDS_ 行) + 元数据枚举 (X-macro) + ALL_LEVELS
│   │   │   ├── TimeIndex.hpp                         # 🧮 时间索引: Clock ↔ L0 ↔ L1, 交易时段常数
│   │   │   ├── DataDefine.hpp                        # 🧮 TickData / MinuteData, Trigger 触发域, 算子契约
│   │   │   ├── ComputeGraph.hpp                      # 🧮 计算图: Node<Op,K> + DAG (CMake 扫描算子文件, 拓扑序生成 NodesGenerated.hpp)
│   │   │   ├── CoreSequential.hpp                    # 🧮 单资产时序: tick → DAG → L0; 分钟边界重采样 → L1; 标签回填
│   │   │   ├── CoreCrosssection.hpp                  # 🧮 截面: 字段表 CS 行编译期展开, L0 每秒 + L1 分钟级联
│   │   │   ├── MetaFlag.hpp                          # 🧮 _meta 列三态 (零 / 正 data / 负 depth) 编解码, 消费端不依赖 Meta 算子
│   │   │   ├── Operator/TS/                          # 🧮 时序算子: 数学 class + 文件末尾 NODE_ / FIELDS_ 宏
│   │   │   ├── Operator/CS/                          # 🧮 截面算子: 只有 FIELDS_ 行 (方法在 Method/CS.hpp)
│   │   │   ├── Operator/unused/                      # 🧮 未启用半成品 (TS / CS 两层)
│   │   │   ├── Method/                               # 🧮 CS.hpp: Tf (None / Reciprocal / Log) × Method (Rank / NormRank / WinsorRank / NeutralRank / Demean / Z / WinsorZ)
│   │   │   │                                         # 🧮 TS.hpp: Tf (None / Log / Asinh / Tanh / Sqrt) × Method (占位)
│   │   │   │                                         # 🧮 Fundamental.hpp: 日频 PIT 基本面数据源 (Pool) + 逐日推进状态机 (Stream), Fund 算子共用
│   │   │   └── Backend/                              # 🧮 特征存储后端
│   │   │       ├── FeatureStoreConfig.hpp            # 🧮 写端: 字段表 + ALL_LEVELS 展开编译期 LEVELS[] (定址折叠), width / valid / psd 全推导
│   │   │       ├── FeatureLevels.hpp                 # 🧮 读端稳定层 (字段表无关): 运行时层表, 增删特征不触发读侧重编
│   │   │       ├── FeatureStore.hpp                  # 🧮 存储引擎: [T][F][A] Float16 槽位, TS / CS / IO 三类 worker 并发协议
│   │   │       ├── FeatureRead.hpp                   # 🧮 读取引擎: 按列选读 (DayTensor 单日 / MonthTensor 多日); 并发安全删库 (多 reader 与清库不互踩)
│   │   │       ├── DayBatchPlane.hpp                 # 🧮 Dist / Transform 共用天批平面: 抢单天并行载入 → [列][A][批天][VR]
│   │   │       ├── SparseCodec.hpp                   # 🧮 落盘编码: 位图 + 非零字面 (内存带宽级, 默认)
│   │   │       └── ZstdCodec.hpp                     # 🧮 落盘编码: zstd 熵压缩 (同 API, 选型在 FeatureStoreConfig)
│   │   ├── worker/                                   # ⚡ 多线程工作流编排
│   │   │   ├── encoding_worker.hpp                   # ⚡ 编码 worker
│   │   │   └── feature_workers.hpp                   # ⚡ 特征计算四角色 (预取 / 时序 / 截面 / 落盘): 统一签名 WorkerCtx + TS 调度面
│   │   ├── label/                                    # 🏷️ 标签生成
