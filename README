│   │   │       ├── Config.hpp                          # 🧬 编译期常量: 可搜持有期 / 硬门槛 kMinMono / 采样点数
│   │   │       ├── Contract.hpp                        # 🧬 语义契约: 分块流式 + 目标函数 + 噪声 + 终选
│   │   │       │                                       #    · 目标 = 固定 h 的每期毛多空 · rIC · mono²; 方向 = rIC 的号; 不看成本, 不跨 h 比
│   │   │       ├── Space.hpp                           # 🧬 参数空间: 可搜槽 → 单调坐标 + 区间 → 低差异采样
│   │   │       ├── Surface.hpp                         # 🧬 曲面: 已评点 → 高斯过程 → 后验 / 峰
│   │   │       └── Cpu.hpp / Gpu.cuh / Check.hpp       # 🧬 CPU (复用 Stat 行核) / GPU 后端 + 对拍
