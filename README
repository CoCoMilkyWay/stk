│   │   │   └── VariableMonitor.hpp                      # 🔧 变量值监控
│   │   └── boost/                                       # 📚 asio / beast / optional (随包, 头文件库)
│   ├── src/                                             # 💾 源文件实现 (多数对应include/, boost/math为header-only无实现)
│   │   ├── main.cpp                                     # 💾 程序入口
│   │   ├── api/ codec/ shared/ misc/ worker/ features/  # 💾 对应模块实现
│   │   ├── gui/Gui.cpp / Tasks.cpp                      # 💾 GUI主循环与任务注册实现
│   │   ├── gui/Run_OpenGL.cpp                           # 💾 OpenGL后端入口
│   │   └── gui/Run_Vulkan.cpp                           # 💾 Vulkan后端入口
│   ├── package/                                         # 📚 第三方库 (源码内置, boost因header-only已放入include/)
│   │   ├── nlohmann/ yyjson/ utfcpp/                    # 📚 JSON / 文本编解码
│   │   ├── zlib-1.3.1/ zstd-1.5.7/ arrow/               # 📚 压缩 / Parquet列式存储
│   │   ├── imgui/ implot/ glfw/                         # 📚 GUI渲染
│   │   ├── microtex/ tinyxml2/                          # 📚 LaTeX渲染 / XML解析
│   │   └── tracy/                                       # 📚 性能剖析
│   ├── fonts/                                           # 🔤 GUI字体文件
│   ├── script/                                          # 🐍 绘图脚本 (bookmap/plot_bars/plot_signals)
│   └── projects/main/                                   # 🏗️ 构建系统
│       ├── CMakeLists.txt                               # 🏗️ CMake配置 (C++23, Clang)
│       └── build/bin/app_main                           # 🎯 最终可执行文件
└── output/                                              # 📁 运行时输出 (与cpp/同级)
    ├── orders/                                          # L2 编码 .bin (逐笔委托+成交合并)
    │   └── YYYY/MM/DD/<CODE>.<EX>.bin                   # 单资产单日一个 .bin
    ├── features/                                        # 特征张量库 (Float16 + Zstd, 按交易日全市场列式)
    │   └── YYYY/MM/DD/
    │       ├── features_L0_f<f>.zst                     # L0 逐特征列 [T×A]
    │       ├── features_L1.zst                          # L1 整层 [T×F×A]
    │       └── depth.zst                                # 盘口深度 [T×DEPTH×A]
    ├── fundamental/                                     # 日频基本面 (表清单见上方 DataBase → Overview)
    │   ├── YYYY-MM/<表>.parquet                         # 月度分片 (2015-01 起, 每表一文件; 0 行月也落文件 = "拉过")
    │   ├── _meta/<表>.parquet                           # Static/Snapshot 单文件整刷 (cn_stock_basic_info / cn_stock_static_data)
    │   ├── asset_axis.json                              # A 轴 (资产轴) 码表, 只增不删
    │   └── pool/*.bin                                   # ⚠ 旧版 PIT 事件池缓存, 现行代码已不再读写
    ├── factors/                                         # 因子库 (预留)
    │   └── YYYY/MM/DD/
    └── log/                                             # 运行日志
```

